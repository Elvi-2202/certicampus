pipeline {
    agent any

    stages {
        // On supprime l'étape "Checkout" manuelle car Jenkins le fait déjà automatiquement
        
        stage('Build Docker') {
            steps {
                dir('backend') {
                    sh 'ls -R'
                    // On vérifie que docker-compose est là et on build
                    sh 'docker-compose build --no-cache'
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('backend') {
                    sh 'docker-compose up -d'
                    // Utilisation du flag -T pour éviter les erreurs de terminal (TTY)
                    sh 'docker-compose exec -T php composer install --no-interaction --optimize-autoloader'
                }
            }
        }

        stage('Database Setup') {
            steps {
                dir('backend') {
                    sh 'docker-compose exec -T php php bin/console doctrine:database:create --if-not-exists'
                    sh 'docker-compose exec -T php php bin/console doctrine:schema:update --force'
                }
            }
        }
    }

    post {
        always {
            // Le "script" et le "dir" assurent que la commande s'exécute au bon endroit
            script {
                try {
                    dir('backend') {
                        sh 'docker-compose down'
                    }
                } catch (Exception e) {
                    echo "Erreur lors du nettoyage : ${e.message}"
                }
            }
        }
    }
}