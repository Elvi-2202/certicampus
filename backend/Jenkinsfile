pipeline {
    agent any

    stages {

        stage('Start containers') {
            steps {
                dir('backend') {
                    sh 'docker-compose down -v'
                    sh 'docker-compose exec -T php ls -la /var/www'
                    sh 'docker-compose up -d --build'
                }
            }
        }

        stage('Wait DB') {
            steps {
                dir('backend') {
                    sh 'sleep 20'
                }
            }
        }

        stage('Composer install') {
            steps {
                dir('backend') {
                    sh 'docker-compose exec -T php composer install --no-interaction --prefer-dist'
                }
            }
        }

        stage('Verify Symfony') {
            steps {
                dir('backend') {
                    sh 'docker-compose exec -T php php bin/console --version'
                }
            }
        }

        stage('Database Setup') {
            steps {
                dir('backend') {

            // sécurité: attendre DB
                sh 'sleep 10'

            // création DB (ignore si existe déjà)
                sh '''
                docker-compose exec -T php php bin/console doctrine:database:create --if-not-exists || true
                '''

            // migrations (VRAI test important)
                sh '''
                docker-compose exec -T php php bin/console doctrine:migrations:migrate --no-interaction
                '''
                 }
            }
        }
    }

    post {
        always {
            dir('backend') {
                sh 'docker-compose down'
            }
        }
    }
}