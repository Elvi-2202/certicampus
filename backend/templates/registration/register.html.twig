{% extends 'base.html.twig' %}

{% block title %}Inscription — CertiCampus{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --ink:       #0f1117;
    --ink-soft:  #4a4f5e;
    --paper:     #faf9f6;
    --cream:     #f0ede6;
    --gold:      #c8a96e;
    --gold-pale: #f5eddc;
    --teal:      #1e6b72;
    --teal-light:#e8f4f5;
    --danger:    #c0392b;
    --radius:    10px;
    --transition: 0.22s ease;
  }

  body {
    font-family: 'DM Sans', sans-serif;
    background-color: var(--paper);
    color: var(--ink);
    min-height: 100vh;
  }

  /* ── Layout ── */
  .auth-shell {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100vh;
  }

  /* ── Left panel ── */
  .auth-panel {
    background-color: var(--teal);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 3rem;
  }

  .auth-panel::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 20% 80%, rgba(200,169,110,.18) 0%, transparent 70%),
      radial-gradient(ellipse 60% 50% at 80% 10%, rgba(255,255,255,.07) 0%, transparent 60%);
  }

  .auth-panel__logo {
    position: relative;
    display: flex;
    align-items: center;
    gap: .75rem;
    text-decoration: none;
  }

  .auth-panel__logo-mark {
    width: 40px; height: 40px;
    background: var(--gold);
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-family: 'DM Serif Display', serif;
    font-size: 1.3rem;
    color: var(--ink);
  }

  .auth-panel__logo-text {
    font-family: 'DM Serif Display', serif;
    font-size: 1.5rem;
    color: #fff;
    letter-spacing: -.01em;
  }

  .auth-panel__content {
    position: relative;
  }

  .auth-panel__eyebrow {
    display: inline-block;
    font-size: .7rem;
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1.25rem;
  }

  .auth-panel__headline {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    color: #fff;
    line-height: 1.15;
    margin-bottom: 1.5rem;
  }

  .auth-panel__headline em {
    font-style: italic;
    color: var(--gold);
  }

  .auth-panel__sub {
    font-size: .95rem;
    color: rgba(255,255,255,.65);
    line-height: 1.7;
    max-width: 30ch;
  }

  .auth-panel__features {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: .75rem;
    margin-top: 2.5rem;
  }

  .feature-pill {
    display: flex;
    align-items: center;
    gap: .75rem;
    background: rgba(255,255,255,.08);
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 50px;
    padding: .55rem 1rem .55rem .6rem;
    width: fit-content;
    animation: float-in .5s ease both;
  }

  .feature-pill:nth-child(2) { animation-delay: .1s; }
  .feature-pill:nth-child(3) { animation-delay: .2s; }

  @keyframes float-in {
    from { opacity: 0; transform: translateX(-16px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  .feature-pill__dot {
    width: 28px; height: 28px;
    background: var(--gold);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: .85rem;
    flex-shrink: 0;
  }

  .feature-pill__text {
    font-size: .82rem;
    font-weight: 500;
    color: rgba(255,255,255,.85);
  }

  .auth-panel__footer {
    position: relative;
    font-size: .78rem;
    color: rgba(255,255,255,.35);
  }

  /* ── Right panel (form) ── */
  .auth-form-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 2rem;
    background: var(--paper);
  }

  .auth-form-box {
    width: 100%;
    max-width: 420px;
    animation: fade-up .4s ease both;
  }

  @keyframes fade-up {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .auth-form-box__title {
    font-family: 'DM Serif Display', serif;
    font-size: 2rem;
    color: var(--ink);
    margin-bottom: .4rem;
    letter-spacing: -.02em;
  }

  .auth-form-box__sub {
    font-size: .9rem;
    color: var(--ink-soft);
    margin-bottom: 2rem;
  }

  .auth-form-box__sub a {
    color: var(--teal);
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px solid transparent;
    transition: border-color var(--transition);
  }

  .auth-form-box__sub a:hover { border-bottom-color: var(--teal); }

  /* ── Alerts ── */
  .alert-danger {
    background: #fdf0ef;
    border: 1px solid #f3c6c3;
    border-radius: var(--radius);
    color: var(--danger);
    padding: .75rem 1rem;
    font-size: .875rem;
    margin-bottom: 1.5rem;
  }

  /* ── Form fields ── */
  .field-row {
    margin-bottom: 1.1rem;
  }

  .field-row label {
    display: block;
    font-size: .8rem;
    font-weight: 600;
    letter-spacing: .03em;
    color: var(--ink);
    margin-bottom: .4rem;
    text-transform: uppercase;
  }

  .field-row input[type="text"],
  .field-row input[type="email"],
  .field-row input[type="password"] {
    width: 100%;
    padding: .75rem 1rem;
    border: 1.5px solid #ddd9d1;
    border-radius: var(--radius);
    background: #fff;
    font-family: 'DM Sans', sans-serif;
    font-size: .95rem;
    color: var(--ink);
    outline: none;
    transition: border-color var(--transition), box-shadow var(--transition);
    appearance: none;
  }

  .field-row input:focus {
    border-color: var(--teal);
    box-shadow: 0 0 0 3px var(--teal-light);
  }

  .field-row input.is-invalid {
    border-color: var(--danger);
  }

  .field-error {
    font-size: .78rem;
    color: var(--danger);
    margin-top: .3rem;
  }

  /* Duo grid for firstname / lastname */
  .field-duo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .75rem;
  }

  /* ── Checkbox ── */
  .checkbox-row {
    display: flex;
    align-items: flex-start;
    gap: .65rem;
    margin-bottom: 1.5rem;
  }

  .checkbox-row input[type="checkbox"] {
    appearance: none;
    width: 18px; height: 18px;
    border: 1.5px solid #ddd9d1;
    border-radius: 4px;
    background: #fff;
    cursor: pointer;
    flex-shrink: 0;
    margin-top: 2px;
    display: grid;
    place-items: center;
    transition: background var(--transition), border-color var(--transition);
  }

  .checkbox-row input[type="checkbox"]:checked {
    background: var(--teal);
    border-color: var(--teal);
  }

  .checkbox-row input[type="checkbox"]:checked::after {
    content: '';
    display: block;
    width: 5px; height: 9px;
    border: 2px solid #fff;
    border-top: none; border-left: none;
    transform: rotate(45deg) translate(-1px, -1px);
  }

  .checkbox-row label {
    font-size: .875rem;
    color: var(--ink-soft);
    cursor: pointer;
    line-height: 1.5;
  }

  .checkbox-row label a {
    color: var(--teal);
    text-decoration: none;
    font-weight: 500;
  }

  /* ── Submit button ── */
  .btn-submit {
    width: 100%;
    padding: .9rem 1.5rem;
    background: var(--teal);
    color: #fff;
    border: none;
    border-radius: var(--radius);
    font-family: 'DM Sans', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    letter-spacing: .01em;
    transition: background var(--transition), transform var(--transition), box-shadow var(--transition);
    position: relative;
    overflow: hidden;
  }

  .btn-submit::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent 30%, rgba(255,255,255,.12) 50%, transparent 70%);
    transform: translateX(-100%);
    transition: transform .5s ease;
  }

  .btn-submit:hover { background: #185960; box-shadow: 0 4px 18px rgba(30,107,114,.3); }
  .btn-submit:hover::after { transform: translateX(100%); }
  .btn-submit:active { transform: scale(.98); }

  /* ── Divider ── */
  .auth-divider {
    display: flex;
    align-items: center;
    gap: .75rem;
    margin: 1.5rem 0 1.25rem;
    color: #ccc8c0;
    font-size: .78rem;
    font-weight: 500;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .auth-divider::before, .auth-divider::after {
    content: ''; flex: 1;
    height: 1px;
    background: #e4e0d9;
  }

  /* ── Responsive ── */
  @media (max-width: 820px) {
    .auth-shell { grid-template-columns: 1fr; }
    .auth-panel { display: none; }
    .auth-form-wrap { padding: 2.5rem 1.25rem; }
  }

  /* Override Symfony form classes to fit our design */
  .auth-form-box form > div { margin-bottom: 0; }
</style>
{% endblock %}

{% block body %}
<div class="auth-shell">

  {# ── Left decorative panel ── #}
  <aside class="auth-panel">
    <a href="{{ path('app_admin_dashboard') }}" class="auth-panel__logo">
      <div class="auth-panel__logo-mark">C</div>
      <span class="auth-panel__logo-text">CertiCampus</span>
    </a>

    <div class="auth-panel__content">
      <span class="auth-panel__eyebrow">Formation professionnelle</span>
      <h2 class="auth-panel__headline">
        Obtenez vos<br>
        certifications<br>
        <em>avec confiance.</em>
      </h2>
      <p class="auth-panel__sub">
        Rejoignez des milliers d'apprenants qui développent leurs compétences et valident leur expertise.
      </p>

      <div class="auth-panel__features">
        <div class="feature-pill">
          <div class="feature-pill__dot">🎓</div>
          <span class="feature-pill__text">Certifications reconnues</span>
        </div>
        <div class="feature-pill">
          <div class="feature-pill__dot">📊</div>
          <span class="feature-pill__text">Suivi de progression en temps réel</span>
        </div>
        <div class="feature-pill">
          <div class="feature-pill__dot">🔐</div>
          <span class="feature-pill__text">Accès sécurisé à vos résultats</span>
        </div>
      </div>
    </div>

    <p class="auth-panel__footer">© {{ "now"|date("Y") }} CertiCampus — Tous droits réservés</p>
  </aside>

  {# ── Right form panel ── #}
  <main class="auth-form-wrap">
    <div class="auth-form-box">

      <h1 class="auth-form-box__title">Créer un compte</h1>
      <p class="auth-form-box__sub">
        Déjà inscrit ? <a href="{{ path('app_login') }}">Se connecter</a>
      </p>

      {{ form_errors(registrationForm) }}

      {{ form_start(registrationForm, {'attr': {'novalidate': 'novalidate'}}) }}

        <div class="field-duo">
          <div class="field-row">
            {{ form_label(registrationForm.firstname, 'Prénom') }}
            {{ form_widget(registrationForm.firstname, {'attr': {'placeholder': 'Marie'}}) }}
            {{ form_errors(registrationForm.firstname) }}
          </div>
          <div class="field-row">
            {{ form_label(registrationForm.lastname, 'Nom') }}
            {{ form_widget(registrationForm.lastname, {'attr': {'placeholder': 'Dupont'}}) }}
            {{ form_errors(registrationForm.lastname) }}
          </div>
        </div>

        <div class="field-row">
          {{ form_label(registrationForm.email, 'Adresse e-mail') }}
          {{ form_widget(registrationForm.email, {'attr': {'placeholder': 'marie.dupont@exemple.fr'}}) }}
          {{ form_errors(registrationForm.email) }}
        </div>

        <div class="field-row">
          {{ form_label(registrationForm.plainPassword, 'Mot de passe') }}
          {{ form_widget(registrationForm.plainPassword, {'attr': {'placeholder': '8 caractères minimum'}}) }}
          {{ form_errors(registrationForm.plainPassword) }}
        </div>

        <div class="checkbox-row">
          {{ form_widget(registrationForm.agreeTerms) }}
          {{ form_label(registrationForm.agreeTerms, "J'accepte les conditions d'utilisation") }}
          {{ form_errors(registrationForm.agreeTerms) }}
        </div>

        <button type="submit" class="btn-submit">Créer mon compte →</button>

      {{ form_end(registrationForm) }}

    </div>
  </main>

</div>
{% endblock %}
