{# ============================================================ #}
{# templates/admin/diplomas/index.html.twig                     #}
{# ============================================================ #}
{% extends 'base.html.twig' %}
{% import 'admin/macros.html.twig' as ui %}
{% block title %}Diplômes — Certicampus{% endblock %}
{% block stylesheets %}{{ ui.sidebar('diplomas') | raw }}{% endblock %}
{% block body %}
<div class="layout">
  {{ ui.sidebar('diplomas') | raw }}
  <main class="main">
    <div class="page-header">
      <div><h1>Diplômes</h1><p>{{ diplomas|length }} diplôme(s) généré(s)</p></div>
      <a href="{{ path('app_admin_diplomas_new') }}" class="btn">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Nouveau diplôme
      </a>
    </div>
    <div class="search-bar"><input type="text" id="search" placeholder="Rechercher..." onkeyup="filterTable()"></div>
    <div class="table-wrap">
      {% if diplomas is empty %}<div class="empty">Aucun diplôme enregistré.</div>
      {% else %}
      <table id="table">
        <thead>
          <tr>
            <th>#</th>
            <th>Fichier</th>
            <th>Niveau</th>
            <th>Généré le</th>
            <th>Statut</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
        {% for d in diplomas %}
        <tr>
          <td style="color:#aaa;">{{ d.id }}</td>
          <td style="font-size:12px; color:#555; max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{{ d.fileUrl }}</td>
          <td style="color:#555;">{{ d.level }}</td>
          <td style="color:#555;">{{ d.generatedAt|date('d/m/Y') }}</td>
          <td>
            {% if d.isValid %}<span class="badge badge-green">Valide</span>
            {% else %}<span class="badge badge-red">Invalide</span>{% endif %}
          </td>
          <td><div class="actions">
            <a href="{{ path('app_admin_diplomas_edit', {id: d.id}) }}" class="btn btn-outline btn-sm">Modifier</a>
            <form method="POST" action="{{ path('app_admin_diplomas_delete', {id: d.id}) }}" onsubmit="return confirm('Supprimer ?')">
              <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ d.id) }}">
              <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
            </form>
          </div></td>
        </tr>
        {% endfor %}
        </tbody>
      </table>
      {% endif %}
    </div>
  </main>
</div>
<script>function filterTable(){const q=document.getElementById('search').value.toLowerCase();document.querySelectorAll('#table tbody tr').forEach(r=>r.style.display=r.textContent.toLowerCase().includes(q)?'':'none');}</script>
{% endblock %}