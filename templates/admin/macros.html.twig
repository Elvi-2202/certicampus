{% macro sidebar(active) %}
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Instrument Sans', 'Helvetica Neue', sans-serif; background: #f5f4f0; color: #1a1a1a; min-height: 100vh; }
  .layout { display: flex; min-height: 100vh; }
  .sidebar { width: 220px; background: #1a1a1a; color: #fff; display: flex; flex-direction: column; padding: 2rem 1.25rem; position: fixed; top: 0; left: 0; bottom: 0; z-index: 10; }
  .sidebar-logo { font-size: 18px; font-weight: 600; letter-spacing: -0.5px; margin-bottom: 2.5rem; color: #fff; text-decoration: none; display: block; }
  .sidebar-logo span { color: #c8f564; }
  .sidebar-nav { display: flex; flex-direction: column; gap: 4px; flex: 1; }
  .nav-item { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-radius: 8px; font-size: 14px; color: #888; text-decoration: none; transition: background 0.15s, color 0.15s; }
  .nav-item:hover { background: #2a2a2a; color: #fff; }
  .nav-item.active { background: #c8f564; color: #1a1a1a; font-weight: 500; }
  .nav-item svg { width: 16px; height: 16px; flex-shrink: 0; }
  .sidebar-footer { border-top: 1px solid #2a2a2a; padding-top: 1rem; font-size: 13px; color: #555; }
  .sidebar-footer strong { display: block; color: #ccc; margin-bottom: 2px; }
  .main { margin-left: 220px; flex: 1; padding: 2.5rem 2rem; }
  .page-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 2rem; }
  .page-header h1 { font-size: 26px; font-weight: 600; letter-spacing: -0.5px; }
  .page-header p { font-size: 14px; color: #888; margin-top: 3px; }
  .btn { display: inline-flex; align-items: center; gap: 6px; padding: 9px 18px; background: #1a1a1a; color: #fff; border: none; border-radius: 8px; font-size: 13px; font-weight: 500; cursor: pointer; text-decoration: none; transition: opacity 0.15s; }
  .btn:hover { opacity: 0.85; }
  .btn-outline { background: #fff; color: #1a1a1a; border: 1px solid #ddd; }
  .btn-outline:hover { background: #f5f4f0; opacity: 1; }
  .btn-danger { background: #fde8e8; color: #a33030; border: none; }
  .card { background: #fff; border-radius: 12px; border: 1px solid #ebebeb; padding: 1.25rem; margin-bottom: 1rem; }
  .table-wrap { background: #fff; border-radius: 12px; border: 1px solid #ebebeb; overflow: hidden; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  thead { background: #f8f8f6; }
  th { padding: 10px 16px; text-align: left; font-weight: 500; font-size: 12px; color: #888; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid #ebebeb; }
  td { padding: 12px 16px; border-bottom: 1px solid #f0f0f0; color: #1a1a1a; vertical-align: middle; }
  tr:last-child td { border-bottom: none; }
  tr:hover td { background: #fafaf8; }
  .badge { font-size: 11px; padding: 3px 9px; border-radius: 20px; font-weight: 500; }
  .badge-green { background: #ecfcd6; color: #3a7a00; }
  .badge-red { background: #fde8e8; color: #a33030; }
  .badge-blue { background: #daedfb; color: #1a5fa0; }
  .badge-gray { background: #f0f0ee; color: #555; }
  .actions { display: flex; gap: 6px; }
  .btn-sm { padding: 5px 10px; font-size: 12px; border-radius: 6px; }
  .empty { text-align: center; padding: 3rem; color: #aaa; font-size: 14px; }
  .search-bar { display: flex; gap: 8px; margin-bottom: 1rem; }
  .search-bar input { flex: 1; padding: 9px 14px; border: 1px solid #ddd; border-radius: 8px; font-size: 13px; font-family: inherit; outline: none; }
  .search-bar input:focus { border-color: #aaa; }
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">

<aside class="sidebar">
  <a href="{{ path('app_admin_dashboard') }}" class="sidebar-logo">Certi<span>campus</span></a>
  <nav class="sidebar-nav">
    <a href="{{ path('app_admin_dashboard') }}" class="nav-item {{ active == 'dashboard' ? 'active' }}">
      <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
      Dashboard
    </a>
    <a href="{{ path('app_admin_trainings') }}" class="nav-item {{ active == 'trainings' ? 'active' }}">
      <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 14l9-5-9-5-9 5 9 5z"/><path d="M12 14l6.16-3.422A12.083 12.083 0 0112 21a12.083 12.083 0 01-6.16-10.422L12 14z"/></svg>
      Formations
    </a>
    <a href="{{ path('app_admin_schools') }}" class="nav-item {{ active == 'schools' ? 'active' }}">
      <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      Écoles
    </a>
    <a href="{{ path('app_admin_certified') }}" class="nav-item {{ active == 'certified' ? 'active' }}">
      <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
      Certifiés
    </a>
    <a href="{{ path('app_admin_diplomas') }}" class="nav-item {{ active == 'diplomas' ? 'active' }}">
      <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      Diplômes
    </a>
    <a href="{{ path('app_admin_template_diplomas') }}" class="nav-item {{ active == 'templates' ? 'active' }}">
      <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
      Templates
    </a>
    <a href="{{ path('app_admin_specialities') }}" class="nav-item {{ active == 'specialities' ? 'active' }}">
      <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M7 7h10M7 12h10M7 17h6"/></svg>
      Spécialités
    </a>
    <a href="{{ path('app_admin_users') }}" class="nav-item {{ active == 'users' ? 'active' }}">
      <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
      <a href="{{ path('app_admin_subscriptions') }}" class="nav-item {{ active == 'subscriptions' ? 'active' }}">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
        Abonnements
      </a>
      Utilisateurs
    </a>
  </nav>
  <div class="sidebar-footer">
    <strong>{{ app.user ? app.user.firstname ~ ' ' ~ app.user.lastname : 'Admin' }}</strong>
    <a href="{{ path('app_logout') }}" style="color:#555; text-decoration:none; font-size:12px;">Se déconnecter</a>
  </div>
</aside>
{% endmacro %}