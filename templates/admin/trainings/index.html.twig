{# ============================================================ #}
{# templates/admin/trainings/index.html.twig                   #}
{# ============================================================ #}
{% extends 'base.html.twig' %}
{% import 'admin/macros.html.twig' as ui %}
{% block title %}Formations — Certicampus{% endblock %}
{% block stylesheets %}{{ ui.sidebar('trainings') | raw }}{% endblock %}
{% block body %}
<div class="layout">
  {{ ui.sidebar('trainings') | raw }}
  <main class="main">
    <div class="page-header">
      <div><h1>Formations</h1><p>{{ trainings|length }} formation(s)</p></div>
      <a href="{{ path('app_admin_trainings_new') }}" class="btn">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Nouvelle formation
      </a>
    </div>
    <div class="search-bar"><input type="text" id="search" placeholder="Rechercher..." onkeyup="filterTable()"></div>
    <div class="table-wrap">
      {% if trainings is empty %}<div class="empty">Aucune formation enregistrée.</div>
      {% else %}
      <table id="table">
        <thead><tr><th>#</th><th>Nom</th><th>Description</th><th>Actions</th></tr></thead>
        <tbody>
        {% for t in trainings %}
        <tr>
          <td style="color:#aaa;">{{ t.id }}</td>
          <td><strong>{{ t.label }}</strong></td>
          <td style="color:#555; max-width:350px;">{{ t.description|default('—')|slice(0,80) }}{% if t.description|length > 80 %}...{% endif %}</td>
          <td><div class="actions">
            <a href="{{ path('app_admin_trainings_edit', {id: t.id}) }}" class="btn btn-outline btn-sm">Modifier</a>
            <form method="POST" action="{{ path('app_admin_trainings_delete', {id: t.id}) }}" onsubmit="return confirm('Supprimer ?')">
              <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ t.id) }}">
              <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
            </form>
          </div></td>
        </tr>
        {% endfor %}
        </tbody>
      </table>
      {% endif %}
    </div>
  </main>
</div>
<script>function filterTable(){const q=document.getElementById('search').value.toLowerCase();document.querySelectorAll('#table tbody tr').forEach(r=>r.style.display=r.textContent.toLowerCase().includes(q)?'':'none');}</script>
{% endblock %}