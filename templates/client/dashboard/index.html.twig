{% extends 'base.html.twig' %}

{% block title %}Espace Client — Certicampus{% endblock %}

{% block stylesheets %}
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body { font-family: 'Instrument Sans', 'Helvetica Neue', sans-serif; background: #f5f4f0; color: #1a1a1a; min-height: 100vh; }

  .layout { display: flex; min-height: 100vh; }

  .sidebar { width: 220px; background: #1a1a1a; color: #fff; display: flex; flex-direction: column; padding: 2rem 1.25rem; position: fixed; top: 0; left: 0; bottom: 0; z-index: 10; }
  .sidebar-logo { font-size: 18px; font-weight: 600; letter-spacing: -0.5px; margin-bottom: 2.5rem; color: #fff; }
  .sidebar-logo span { color: #c8f564; }
  .sidebar-nav { display: flex; flex-direction: column; gap: 4px; flex: 1; }
  .nav-item { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-radius: 8px; font-size: 14px; color: #888; text-decoration: none; transition: background 0.15s, color 0.15s; }
  .nav-item:hover { background: #2a2a2a; color: #fff; }
  .nav-item.active { background: #c8f564; color: #1a1a1a; font-weight: 500; }
  .nav-item svg { width: 16px; height: 16px; flex-shrink: 0; }
  .sidebar-footer { border-top: 1px solid #2a2a2a; padding-top: 1rem; font-size: 13px; color: #555; }
  .sidebar-footer strong { display: block; color: #ccc; margin-bottom: 2px; }

  .main { margin-left: 220px; flex: 1; padding: 2.5rem 2rem; max-width: calc(100vw - 220px); }

  .page-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 2rem; }
  .page-header h1 { font-size: 26px; font-weight: 600; letter-spacing: -0.5px; color: #1a1a1a; }
  .page-header p { font-size: 14px; color: #888; margin-top: 3px; }

  .btn { display: inline-flex; align-items: center; gap: 6px; padding: 9px 18px; background: #1a1a1a; color: #fff; border: none; border-radius: 8px; font-size: 13px; font-weight: 500; cursor: pointer; text-decoration: none; transition: opacity 0.15s; }
  .btn:hover { opacity: 0.85; }

  .kpi-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-bottom: 1.75rem; }
  .kpi-card { background: #fff; border-radius: 12px; padding: 1.25rem; border: 1px solid #ebebeb; position: relative; overflow: hidden; }
  .kpi-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; }
  .kpi-card.green::before { background: #c8f564; }
  .kpi-card.blue::before { background: #6ec6f5; }
  .kpi-label { font-size: 12px; color: #888; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px; display: flex; align-items: center; gap: 6px; }
  .kpi-label svg { width: 14px; height: 14px; }
  .kpi-value { font-size: 32px; font-weight: 600; letter-spacing: -1px; color: #1a1a1a; line-height: 1; }
  .kpi-sub { font-size: 12px; color: #aaa; margin-top: 4px; }

  /* CHARTS */
  .charts-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 1.75rem; }
  .chart-card { background: #fff; border-radius: 12px; border: 1px solid #ebebeb; padding: 1.25rem; }
  .chart-title { font-size: 14px; font-weight: 600; color: #1a1a1a; margin-bottom: 1rem; }
  .chart-container { position: relative; height: 200px; }

  .cards-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 1.75rem; }
  .card { background: #fff; border-radius: 12px; border: 1px solid #ebebeb; padding: 1.25rem; }
  .card-title { font-size: 14px; font-weight: 600; color: #1a1a1a; margin-bottom: 1rem; display: flex; align-items: center; gap: 8px; }
  .card-title svg { width: 16px; height: 16px; color: #888; }

  .list-item { display: flex; align-items: center; justify-content: space-between; padding: 10px 12px; background: #f8f8f6; border-radius: 8px; margin-bottom: 6px; }
  .list-item:last-child { margin-bottom: 0; }
  .list-item-label { font-size: 13px; font-weight: 500; color: #1a1a1a; }
  .list-item-sub { font-size: 12px; color: #888; margin-top: 2px; }

  .badge { font-size: 11px; padding: 3px 9px; border-radius: 20px; font-weight: 500; }
  .badge-green { background: #ecfcd6; color: #3a7a00; }

  .avatar { width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; flex-shrink: 0; }
  .avatar-blue { background: #daedfb; color: #1a5fa0; }
  .avatar-green { background: #ecfcd6; color: #3a7a00; }

  .filter-section { background: #fff; border-radius: 12px; border: 1px solid #ebebeb; padding: 1rem; margin-bottom: 1.75rem; display: flex; align-items: center; gap: 1rem; }
  .filter-label { font-size: 13px; font-weight: 500; color: #1a1a1a; white-space: nowrap; }
  .filter-select { flex: 1; max-width: 300px; padding: 8px 12px; border: 1px solid #ddd; border-radius: 6px; font-size: 13px; background: #fff; cursor: pointer; transition: border-color 0.15s; }
  .filter-select:hover { border-color: #c8f564; }
  .filter-select:focus { outline: none; border-color: #c8f564; box-shadow: 0 0 0 2px rgba(200,245,100,0.1); }

  .checkbox-wrapper { display: flex; align-items: center; gap: 8px; padding: 8px 0; }
  .checkbox-wrapper input[type="checkbox"] { width: 16px; height: 16px; cursor: pointer; accent-color: #c8f564; }

  .action-buttons { display: flex; gap: 6px; align-items: center; }
  .btn-small { display: inline-flex; align-items: center; gap: 4px; padding: 6px 12px; background: #1a1a1a; color: #fff; border: none; border-radius: 6px; font-size: 12px; font-weight: 500; cursor: pointer; text-decoration: none; transition: opacity 0.15s; }
  .btn-small:hover { opacity: 0.85; }
  .btn-small.secondary { background: #f0f0f0; color: #1a1a1a; border: 1px solid #ddd; }
  .btn-small.secondary:hover { background: #e5e5e5; }
  .btn-small.success { background: #c8f564; color: #1a1a1a; }
  .btn-small.success:hover { background: #b8e554; }

  .generate-btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; background: #c8f564; color: #1a1a1a; border: none; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; text-decoration: none; transition: opacity 0.15s; margin-top: 1rem; }
  .generate-btn:hover { opacity: 0.85; }
  .generate-btn:disabled { opacity: 0.5; cursor: not-allowed; }

  .alert { padding: 12px 16px; border-radius: 8px; margin-bottom: 1rem; font-size: 13px; display: flex; align-items: center; gap: 8px; }
  .alert-success { background: #ecfcd6; color: #3a7a00; border: 1px solid #d4f5b0; }
  .alert-error { background: #ffe0e0; color: #a50000; border: 1px solid #ffcccc; }

  .student-selection-section { background: #fff; border-radius: 12px; border: 1px solid #ebebeb; padding: 1.25rem; margin-bottom: 1.75rem; }
  .section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
  .section-title { font-size: 14px; font-weight: 600; color: #1a1a1a; display: flex; align-items: center; gap: 8px; }
  .select-all-checkbox { display: flex; align-items: center; gap: 8px; }
  .selected-count { font-size: 12px; color: #888; background: #f8f8f6; padding: 4px 10px; border-radius: 12px; }

  @media (max-width: 900px) {
    .kpi-grid, .cards-grid, .charts-grid { grid-template-columns: 1fr; }
    .sidebar { width: 80px; padding: 1.5rem 0.75rem; }
    .sidebar-logo, .nav-item span, .sidebar-footer { display: none; }
    .main { margin-left: 80px; max-width: calc(100vw - 80px); }
    .filter-section { flex-direction: column; align-items: flex-start; }
    .filter-select { max-width: 100%; width: 100%; }
  }
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
{% endblock %}

{% block body %}
<div class="layout">

  <aside class="sidebar">
    <div class="sidebar-logo">Certi<span>campus</span></div>
    <nav class="sidebar-nav">
      <a href="{{ path('app_client_dashboard') }}" class="nav-item active">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        Dashboard
      </a>
      <a href="{{ path('app_client_student_list') }}" class="nav-item">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
        Mes Étudiants
      </a>
      <a href="{{ path('app_client_diploma_list') }}" class="nav-item">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        Diplômes
      </a>
    </nav>
    <div class="sidebar-footer">
      <strong>{{ app.user.email }}</strong>
      <a href="{{ path('app_logout') }}" style="color:#555; text-decoration:none; font-size:12px;">Déconnexion</a>
    </div>
  </aside>

  <main class="main">

    {% for message in app.flashes('success') %}
      <div class="alert alert-success">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
        {{ message }}
      </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
      <div class="alert alert-error">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        {{ message }}
      </div>
    {% endfor %}

    <div class="page-header">
      <div>
        <h1>Dashboard Client</h1>
        <p>Bienvenue sur Certicampus — {{ "now"|date("d/m/Y") }}</p>
      </div>
      <a href="{{ path('app_client_student_list') }}" class="btn">Voir les étudiants</a>
    </div>

    {# KPI #}
    <div class="kpi-grid">
      <div class="kpi-card green">
        <div class="kpi-label">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
          Étudiants certifiés
        </div>
        <div class="kpi-value">{{ total_certified }}</div>
        <div class="kpi-sub">étudiants diplômés</div>
      </div>
      <div class="kpi-card blue">
        <div class="kpi-label">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          Diplômes
        </div>
        <div class="kpi-value">{{ total_diplomas }}</div>
        <div class="kpi-sub">niveaux disponibles</div>
      </div>
    </div>

    {# GRAPHIQUES #}
    <div class="charts-grid">
      <div class="chart-card">
        <div class="chart-title">Répartition par grade</div>
        <div class="chart-container">
          <canvas id="gradeChart"></canvas>
        </div>
      </div>
      <div class="chart-card">
        <div class="chart-title">Certifications par mois ({{ "now"|date("Y") }})</div>
        <div class="chart-container">
          <canvas id="monthChart"></canvas>
        </div>
      </div>
    </div>

    {# FILTRE #}
    <div class="filter-section">
      <span class="filter-label">Filtrer par spécialité :</span>
      <form method="GET" style="display: flex; gap: 1rem; align-items: center; flex: 1;">
        <select name="speciality" class="filter-select" onchange="this.form.submit()">
          <option value="">-- Toutes les spécialités --</option>
          {% for spec in specialities %}
            <option value="{{ spec.id }}" {% if selected_speciality == spec.id %}selected{% endif %}>
              {{ spec.label }}
            </option>
          {% endfor %}
        </select>
      </form>
    </div>

    {# SÉLECTION ÉTUDIANTS #}
    <form method="POST" action="{{ path('app_client_diploma_generate') }}" id="diplomaForm">
      <div class="student-selection-section">
        <div class="section-header">
          <div class="section-title">
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
            Sélectionner les étudiants pour générer des diplômes
          </div>
          <div style="display: flex; align-items: center; gap: 1rem;">
            <span class="selected-count" id="selectedCount">0 sélectionné(s)</span>
            <div class="select-all-checkbox">
              <input type="checkbox" id="selectAll" onchange="toggleSelectAll(this)">
              <label for="selectAll" style="font-size: 13px; cursor: pointer;">Tout sélectionner</label>
            </div>
          </div>
        </div>

        {% set colors = ['avatar-blue', 'avatar-green'] %}

        {% for student in certified_students %}
          <div class="checkbox-wrapper">
            <input type="checkbox" name="students[]" value="{{ student.id }}" class="student-checkbox" onchange="updateSelectedCount()">
            <div class="avatar {{ colors[loop.index0 % 2] }}">{{ student.label|slice(0,2)|upper }}</div>
            <div style="flex: 1;">
              <div class="list-item-label">{{ student.label }}</div>
              <div class="list-item-sub">Gradué le {{ student.graduationDate|date('d/m/Y') }}</div>
            </div>
            <span class="badge badge-green">Certifié</span>
          </div>
        {% else %}
          <p style="font-size:13px; color:#aaa; text-align:center; padding:1rem 0;">Aucun étudiant trouvé</p>
        {% endfor %}

        <button type="submit" class="generate-btn" id="generateBtn" disabled>
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="12 5 12 19"/><polyline points="5 12 12 19 19 12"/></svg>
          Générer les diplômes
        </button>
      </div>
    </form>

    {# CARDS #}
    <div class="cards-grid">
      <div class="card">
        <div class="card-title">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
          Derniers étudiants
        </div>
        {% for student in certified_students|slice(0, 5) %}
          <div class="list-item">
            <div style="display:flex; align-items:center; gap:10px;">
              <div class="avatar {{ colors[loop.index0 % 2] }}">{{ student.label|slice(0,2)|upper }}</div>
              <div>
                <div class="list-item-label">{{ student.label }}</div>
                <div class="list-item-sub">{{ student.graduationDate|date('d/m/Y') }}</div>
              </div>
            </div>
            <span class="badge badge-green">Certifié</span>
          </div>
        {% else %}
          <p style="font-size:13px; color:#aaa; text-align:center; padding:1rem 0;">Aucun étudiant trouvé</p>
        {% endfor %}
      </div>

      <div class="card">
        <div class="card-title">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          Diplômes disponibles
        </div>
        {% for diploma in diplomas %}
          <div class="list-item" style="display: flex; justify-content: space-between; align-items: center;">
            <div style="flex: 1;">
              <div class="list-item-label">Diplôme #{{ diploma.id }}</div>
              <div class="list-item-sub">Généré le {{ diploma.generatedAt|date('d/m/Y') }}</div>
            </div>
            <div class="action-buttons">
              <a href="{{ path('app_client_diploma_view', {'id': diploma.id}) }}" class="btn-small secondary" title="Visualiser">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </a>
              <form method="POST" action="{{ path('app_client_diploma_publish', {'id': diploma.id}) }}" style="display: inline;">
                <button type="submit" class="btn-small success" title="Publier">
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 14c1.49-1.46 3-3.6 3-6A7 7 0 005.64 5.64"/><path d="M5 10l7 7"/></svg>
                </button>
              </form>
            </div>
          </div>
        {% else %}
          <p style="font-size:13px; color:#aaa; text-align:center; padding:1rem 0;">Aucun diplôme disponible</p>
        {% endfor %}
      </div>
    </div>

  </main>
</div>

<script>
// Graphique camembert — répartition par grade
const gradeData = {{ grade_stats|json_encode|raw }};
const gradeLabels = Object.keys(gradeData);
const gradeValues = Object.values(gradeData);

new Chart(document.getElementById('gradeChart'), {
  type: 'doughnut',
  data: {
    labels: gradeLabels,
    datasets: [{
      data: gradeValues,
      backgroundColor: ['#c8f564', '#6ec6f5', '#f5a623', '#ff6b6b', '#a78bfa'],
      borderWidth: 0,
    }]
  },
  options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: { position: 'bottom', labels: { font: { size: 12 }, padding: 12 } }
    }
  }
});

// Graphique barres — certifications par mois
const monthData = {{ month_stats|json_encode|raw }};
const monthLabels = ['Jan','Fév','Mar','Avr','Mai','Jun','Jul','Aoû','Sep','Oct','Nov','Déc'];

new Chart(document.getElementById('monthChart'), {
  type: 'bar',
  data: {
    labels: monthLabels,
    datasets: [{
      label: 'Certifications',
      data: monthData,
      backgroundColor: '#c8f564',
      borderRadius: 6,
      borderSkipped: false,
    }]
  },
  options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: { legend: { display: false } },
    scales: {
      y: { beginAtZero: true, ticks: { stepSize: 1 }, grid: { color: '#f0f0f0' } },
      x: { grid: { display: false } }
    }
  }
});

// Sélection étudiants
function updateSelectedCount() {
  const count = document.querySelectorAll('.student-checkbox:checked').length;
  document.getElementById('selectedCount').textContent = count + ' sélectionné(s)';
  document.getElementById('generateBtn').disabled = count === 0;
}

function toggleSelectAll(checkbox) {
  document.querySelectorAll('.student-checkbox').forEach(cb => cb.checked = checkbox.checked);
  updateSelectedCount();
}

document.addEventListener('DOMContentLoaded', updateSelectedCount);
</script>
{% endblock %}