{% extends 'base.html.twig' %}

{% block title %}Visualiser Diplôme — Certicampus{% endblock %}

{% block stylesheets %}
<style>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: 'Instrument Sans', 'Helvetica Neue', sans-serif;
    background: #f5f4f0;
    color: #1a1a1a;
    min-height: 100vh;
  }

  .layout {
    display: flex;
    min-height: 100vh;
  }

  /* Sidebar */
  .sidebar {
    width: 220px;
    background: #1a1a1a;
    color: #fff;
    display: flex;
    flex-direction: column;
    padding: 2rem 1.25rem;
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    z-index: 10;
  }

  .sidebar-logo {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.5px;
    margin-bottom: 2.5rem;
    color: #fff;
  }

  .sidebar-logo span {
    color: #c8f564;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    border-radius: 8px;
    font-size: 14px;
    color: #888;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }

  .nav-item:hover {
    background: #2a2a2a;
    color: #fff;
  }

  .nav-item.active {
    background: #c8f564;
    color: #1a1a1a;
    font-weight: 500;
  }

  .nav-item svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .sidebar-footer {
    border-top: 1px solid #2a2a2a;
    padding-top: 1rem;
    font-size: 13px;
    color: #555;
  }

  .sidebar-footer strong {
    display: block;
    color: #ccc;
    margin-bottom: 2px;
  }

  /* Main */
  .main {
    margin-left: 220px;
    flex: 1;
    padding: 2.5rem 2rem;
    max-width: calc(100vw - 220px);
  }

  .page-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 2rem;
  }

  .page-header h1 {
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.5px;
    color: #1a1a1a;
  }

  .page-header p {
    font-size: 14px;
    color: #888;
    margin-top: 3px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 18px;
    background: #1a1a1a;
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .btn:hover {
    opacity: 0.85;
  }

  .btn-primary {
    background: #c8f564;
    color: #1a1a1a;
  }

  .btn-secondary {
    background: #f0f0f0;
    color: #1a1a1a;
    border: 1px solid #ddd;
  }

  .btn-secondary:hover {
    background: #e5e5e5;
  }

  /* Diploma Viewer */
  .diploma-container {
    background: #fff;
    border-radius: 12px;
    border: 1px solid #ebebeb;
    padding: 2rem;
    margin-bottom: 2rem;
  }

  .diploma-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #ebebeb;
  }

  .diploma-info h2 {
    font-size: 18px;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 0.5rem;
  }

  .diploma-info p {
    font-size: 13px;
    color: #888;
  }

  .diploma-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 6px 12px;
    background: #ecfcd6;
    color: #3a7a00;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 500;
  }

  .diploma-viewer {
    background: #f8f8f6;
    border: 2px dashed #ddd;
    border-radius: 8px;
    padding: 3rem 2rem;
    text-align: center;
    margin-bottom: 2rem;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .diploma-preview {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .diploma-icon {
    width: 64px;
    height: 64px;
    background: #c8f564;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .diploma-icon svg {
    width: 40px;
    height: 40px;
    color: #1a1a1a;
  }

  .diploma-preview-text h3 {
    font-size: 16px;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 0.5rem;
  }

  .diploma-preview-text p {
    font-size: 13px;
    color: #888;
    margin-bottom: 1rem;
  }

  .diploma-details {
    background: #f8f8f6;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 2rem;
  }

  .details-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .detail-item {
    padding: 1rem;
    background: #fff;
    border-radius: 6px;
    border: 1px solid #ebebeb;
  }

  .detail-label {
    font-size: 12px;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 0.5rem;
  }

  .detail-value {
    font-size: 14px;
    font-weight: 600;
    color: #1a1a1a;
  }

  .action-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .action-buttons form {
    display: inline;
  }

  /* Back link */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #888;
    text-decoration: none;
    font-size: 13px;
    margin-bottom: 1.5rem;
    transition: color 0.15s;
  }

  .back-link:hover {
    color: #1a1a1a;
  }

  .back-link svg {
    width: 16px;
    height: 16px;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .sidebar {
      width: 80px;
      padding: 1.5rem 0.75rem;
    }

    .sidebar-logo,
    .nav-item span,
    .sidebar-footer {
      display: none;
    }

    .main {
      margin-left: 80px;
      max-width: calc(100vw - 80px);
    }

    .diploma-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .details-grid {
      grid-template-columns: 1fr;
    }

    .action-buttons {
      flex-direction: column;
    }

    .action-buttons .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="layout">

  {# Sidebar Client #}
  <aside class="sidebar">
    <div class="sidebar-logo">
      Certi<span>campus</span>
    </div>

    <nav class="sidebar-nav">

      <a href="{{ path('app_client_dashboard') }}" class="nav-item">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <rect x="3" y="3" width="7" height="7" rx="1"/>
          <rect x="14" y="3" width="7" height="7" rx="1"/>
          <rect x="3" y="14" width="7" height="7" rx="1"/>
          <rect x="14" y="14" width="7" height="7" rx="1"/>
        </svg>
        Dashboard
      </a>

      <a href="{{ path('app_client_student_list') }}" class="nav-item">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="12" cy="8" r="4"/>
          <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
        </svg>
        Mes Étudiants
      </a>

      <a href="{{ path('app_client_diploma_list') }}" class="nav-item active">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
        </svg>
        Diplômes
      </a>

    </nav>

    <div class="sidebar-footer">
      <strong>{{ app.user.email }}</strong>
      <a href="{{ path('app_logout') }}" style="color:#555; text-decoration:none; font-size:12px;">
        Déconnexion
      </a>
    </div>
  </aside>

  {# Main Content #}
  <main class="main">

    <a href="{{ path('app_client_diploma_list') }}" class="back-link">
      <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
      Retour aux diplômes
    </a>

    <div class="page-header">
      <div>
        <h1>Visualiser le Diplôme</h1>
        <p>Diplôme généré le {{ diploma.generatedAt|date('d/m/Y à H:i') }}</p>
      </div>

      <div class="diploma-status">
        <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
        </svg>
        {% if diploma.isValid %}
          Valide
        {% else %}
          En attente de validation
        {% endif %}
      </div>
    </div>

    {# Diploma Container #}
    <div class="diploma-container">
      
      <div class="diploma-header">
        <div class="diploma-info">
          <h2>Diplôme #{{ diploma.id }}</h2>
          <p>Généré le {{ diploma.generatedAt|date('d/m/Y') }}</p>
        </div>
      </div>

      {# Diploma Viewer #}
      <div class="diploma-viewer">
        <div class="diploma-preview">
          <div class="diploma-icon">
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="12" y1="11" x2="12" y2="17"/>
              <line x1="9" y1="14" x2="15" y2="14"/>
            </svg>
          </div>
          <div class="diploma-preview-text">
            <h3>Diplôme PDF</h3>
            <p>Cliquez sur "Télécharger" pour obtenir le diplôme en PDF</p>
            <p style="font-size: 12px; color: #aaa;">Fichier : {{ diploma.fileUrl|split('/')|last }}</p>
          </div>
        </div>
      </div>

      {# Diploma Details #}
      <div class="diploma-details">
        <div class="details-grid">
          <div class="detail-item">
            <div class="detail-label">État de validation</div>
            <div class="detail-value">
              {% if diploma.isValid %}
                <span style="color: #3a7a00;">✓ Valide</span>
              {% else %}
                <span style="color: #ff9800;">En attente</span>
              {% endif %}
            </div>
          </div>

          <div class="detail-item">
            <div class="detail-label">Date de génération</div>
            <div class="detail-value">{{ diploma.generatedAt|date('d/m/Y H:i') }}</div>
          </div>

          <div class="detail-item">
            <div class="detail-label">ID du diplôme</div>
            <div class="detail-value">#{{ diploma.id }}</div>
          </div>

          <div class="detail-item">
            <div class="detail-label">Type</div>
            <div class="detail-value">Diplôme d'études</div>
          </div>
        </div>
      </div>

      {# Action Buttons #}
      <div class="action-buttons">
        <a href="{{ diploma.fileUrl }}" class="btn btn-primary" download>
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          Télécharger le diplôme
        </a>

        <form method="POST" action="{{ path('app_client_diploma_publish', {'id': diploma.id}) }}" style="display: inline;">
          <button type="submit" class="btn btn-primary">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M19 14c1.49-1.46 3-3.6 3-6A7 7 0 0 0 5.64 5.64"/>
              <path d="M5 10l7 7"/>
            </svg>
            Publier le diplôme
          </button>
        </form>

        <a href="{{ path('app_client_diploma_list') }}" class="btn btn-secondary">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <polyline points="15 18l-6-6 6-6"/>
          </svg>
          Retour à la liste
        </a>
      </div>

    </div>

  </main>
</div>
{% endblock %}
