{% extends 'base.html.twig' %}

{% block title %}Import Excel — Certicampus{% endblock %}

{% block stylesheets %}
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Instrument Sans', sans-serif; background: #f5f4f0; color: #1a1a1a; }
  .layout { display: flex; min-height: 100vh; }

  .sidebar { width: 220px; background: #1a1a1a; color: #fff; display: flex; flex-direction: column; padding: 2rem 1.25rem; position: fixed; top: 0; left: 0; bottom: 0; z-index: 10; }
  .sidebar-logo { font-size: 18px; font-weight: 600; margin-bottom: 2.5rem; color: #fff; }
  .sidebar-logo span { color: #c8f564; }
  .sidebar-nav { display: flex; flex-direction: column; gap: 4px; flex: 1; }
  .nav-item { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-radius: 8px; font-size: 14px; color: #888; text-decoration: none; transition: background 0.15s, color 0.15s; }
  .nav-item:hover { background: #2a2a2a; color: #fff; }
  .nav-item.active { background: #c8f564; color: #1a1a1a; font-weight: 500; }
  .nav-item svg { width: 16px; height: 16px; flex-shrink: 0; }
  .sidebar-footer { border-top: 1px solid #2a2a2a; padding-top: 1rem; font-size: 13px; color: #555; }
  .sidebar-footer strong { display: block; color: #ccc; margin-bottom: 2px; }

  .main { margin-left: 220px; flex: 1; padding: 2.5rem 2rem; }

  .page-header { margin-bottom: 2rem; }
  .page-header h1 { font-size: 26px; font-weight: 600; }
  .page-header p { font-size: 14px; color: #888; margin-top: 3px; }

  .alert { padding: 12px 16px; border-radius: 8px; margin-bottom: 1rem; font-size: 13px; display: flex; align-items: center; gap: 8px; }
  .alert-success { background: #ecfcd6; color: #3a7a00; border: 1px solid #d4f5b0; }
  .alert-error { background: #ffe0e0; color: #a50000; border: 1px solid #ffcccc; }

  .import-card { background: #fff; border-radius: 12px; border: 1px solid #ebebeb; padding: 2rem; max-width: 600px; }

  .drop-zone {
    border: 2px dashed #ddd; border-radius: 10px; padding: 3rem 2rem;
    text-align: center; cursor: pointer; transition: border-color 0.2s, background 0.2s;
    margin-bottom: 1.5rem;
  }
  .drop-zone:hover, .drop-zone.dragover { border-color: #c8f564; background: #f9ffe6; }
  .drop-zone svg { width: 40px; height: 40px; color: #bbb; margin-bottom: 1rem; }
  .drop-zone p { font-size: 14px; color: #888; margin-bottom: 0.5rem; }
  .drop-zone small { font-size: 12px; color: #bbb; }

  .file-input { display: none; }

  .btn { display: inline-flex; align-items: center; gap: 6px; padding: 10px 20px; background: #1a1a1a; color: #fff; border: none; border-radius: 8px; font-size: 13px; font-weight: 500; cursor: pointer; text-decoration: none; transition: opacity 0.15s; width: 100%; justify-content: center; }
  .btn:hover { opacity: 0.85; }
  .btn:disabled { opacity: 0.5; cursor: not-allowed; }

  .format-info { background: #f8f8f6; border-radius: 8px; padding: 1rem 1.25rem; margin-top: 1.5rem; }
  .format-info h3 { font-size: 13px; font-weight: 600; margin-bottom: 0.75rem; color: #1a1a1a; }
  .format-table { width: 100%; border-collapse: collapse; font-size: 12px; }
  .format-table th { text-align: left; padding: 6px 8px; background: #efefec; color: #555; }
  .format-table td { padding: 6px 8px; border-bottom: 1px solid #efefec; color: #333; }

  .file-selected { font-size: 13px; color: #3a7a00; margin-top: 0.5rem; text-align: center; }
</style>
{% endblock %}

{% block body %}
<div class="layout">

  <aside class="sidebar">
    <div class="sidebar-logo">Certi<span>campus</span></div>
    <nav class="sidebar-nav">
      <a href="{{ path('app_client_dashboard') }}" class="nav-item">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        Dashboard
      </a>
      <a href="{{ path('app_client_student_list') }}" class="nav-item">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
        Mes Étudiants
      </a>
      <a href="{{ path('app_client_diploma_list') }}" class="nav-item">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        Diplômes
      </a>
      <a href="{{ path('app_client_import') }}" class="nav-item active">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0018 9h-1.26A8 8 0 103 16.3"/></svg>
        Import Excel
      </a>
    </nav>
    <div class="sidebar-footer">
      <strong>{{ app.user.email }}</strong>
      <a href="{{ path('app_logout') }}" style="color:#555; text-decoration:none; font-size:12px;">Déconnexion</a>
    </div>
  </aside>

  <main class="main">

    <div class="page-header">
      <h1>Import Excel</h1>
      <p>Importez votre liste d'étudiants depuis un fichier Excel</p>
    </div>

    {% for message in app.flashes('success') %}
      <div class="alert alert-success">✅ {{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
      <div class="alert alert-error">❌ {{ message }}</div>
    {% endfor %}

    <div class="import-card">
      <form method="POST" action="{{ path('app_client_import_post') }}" enctype="multipart/form-data" id="importForm">

        <div class="drop-zone" id="dropZone" onclick="document.getElementById('excel_file').click()">
          <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="12" y1="11" x2="12" y2="17"/>
            <polyline points="9 14 12 11 15 14"/>
          </svg>
          <p>Glissez votre fichier ici ou cliquez pour sélectionner</p>
          <small>Formats acceptés : .xlsx, .xls, .csv</small>
        </div>

        <input type="file" name="excel_file" id="excel_file" class="file-input" accept=".xlsx,.xls,.csv" onchange="fileSelected(this)">
        <div class="file-selected" id="fileSelectedLabel"></div>

        <br>
        <button type="submit" class="btn" id="submitBtn" disabled>
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0018 9h-1.26A8 8 0 103 16.3"/></svg>
          Importer les étudiants
        </button>
      </form>

      <div class="format-info">
        <h3>Format attendu du fichier Excel</h3>
        <table class="format-table">
          <thead>
            <tr>
              <th>Colonne A</th>
              <th>Colonne B</th>
              <th>Colonne C</th>
              <th>Colonne D</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Nom de l'étudiant</strong></td>
              <td><strong>Adresse mail</strong></td>
              <td><strong>Niveau</strong></td>
              <td><strong>Numéro de téléphone</strong></td>
            </tr>
            <tr>
              <td>Jean Dupont</td>
              <td>jean.dupont@email.com</td>
              <td>Licence</td>
              <td>0612345678</td>
            </tr>
            <tr>
              <td>Marie Martin</td>
              <td>marie.martin@email.com</td>
              <td>Master</td>
              <td>+33 7 12 34 56 78</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

  </main>
</div>

<script>
function fileSelected(input) {
  const label = document.getElementById('fileSelectedLabel');
  const btn = document.getElementById('submitBtn');
  if (input.files.length > 0) {
    label.textContent = '📎 ' + input.files[0].name;
    btn.disabled = false;
  } else {
    label.textContent = '';
    btn.disabled = true;
  }
}

const dropZone = document.getElementById('dropZone');
dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('dragover'); });
dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
dropZone.addEventListener('drop', e => {
  e.preventDefault();
  dropZone.classList.remove('dragover');
  const file = e.dataTransfer.files[0];
  const input = document.getElementById('excel_file');
  const dt = new DataTransfer();
  dt.items.add(file);
  input.files = dt.files;
  fileSelected(input);
});
</script>
{% endblock %}