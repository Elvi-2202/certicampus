{# templates/client/student/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Étudiants certifiés{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@700;800&display=swap" rel="stylesheet">
<style>
/* ── Reset & tokens ── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --navy:   #1E3A5F;
  --dark:   #0F172A;
  --bg:     #F0F4FF;
  --card:   #FFFFFF;
  --blue:   #3B82F6;
  --blue2:  #2563EB;
  --green:  #059669;
  --amber:  #D97706;
  --red:    #DC2626;
  --slate:  #94A3B8;
  --border: #E2E8F0;
  --text:   #1E293B;
  --muted:  #64748B;
  --r:      10px;
  --sh:     0 1px 3px rgba(15,23,42,.06), 0 2px 12px rgba(15,23,42,.04);
}
body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); }

/* ── Header ── */
.page-header {
  background: linear-gradient(135deg, var(--dark) 0%, var(--navy) 100%);
  padding: 32px 32px 28px;
}
.page-header h1 {
  font-family: 'Sora', sans-serif;
  font-size: 1.6rem; font-weight: 800;
  color: #fff; letter-spacing: -.02em;
}
.page-header p { color: #93C5FD; font-size: .875rem; margin-top: 4px; }

.kpi-row {
  display: flex; gap: 16px; margin-top: 24px; flex-wrap: wrap;
}
.kpi {
  background: rgba(255,255,255,.09);
  border: 1px solid rgba(255,255,255,.13);
  border-radius: var(--r);
  padding: 14px 20px; min-width: 120px;
}
.kpi-val {
  font-family: 'Sora', sans-serif;
  font-size: 1.75rem; font-weight: 800;
  color: #fff; line-height: 1;
}
.kpi-lbl { font-size: .7rem; text-transform: uppercase; letter-spacing: .07em; color: #93C5FD; margin-top: 4px; }

/* ── Content wrapper ── */
.wrap { max-width: 1280px; margin: 0 auto; padding: 28px 32px 60px; }

/* ── Flash ── */
.flashes { display: flex; flex-direction: column; gap: 8px; margin-bottom: 20px; }
.flash { padding: 11px 16px; border-radius: 8px; font-size: .875rem; font-weight: 500; }
.flash-success { background: #D1FAE5; color: #065F46; border: 1px solid #A7F3D0; }
.flash-warning { background: #FEF3C7; color: #92400E; border: 1px solid #FDE68A; }
.flash-danger  { background: #FEE2E2; color: #991B1B; border: 1px solid #FECACA; }

/* ── 3.6 Filtre ── */
.filter-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--r);
  box-shadow: var(--sh);
  padding: 14px 18px;
  display: flex; gap: 10px; align-items: center; flex-wrap: wrap;
  margin-bottom: 16px;
}
.filter-card label {
  font-size: .7rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: .07em;
  color: var(--muted); white-space: nowrap;
}
.f-search { position: relative; flex: 1; min-width: 180px; }
.f-search svg { position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: var(--slate); pointer-events: none; }
.f-search input {
  width: 100%; padding: 8px 10px 8px 34px;
  border: 1px solid var(--border); border-radius: 7px;
  font-family: inherit; font-size: .875rem; color: var(--text);
  background: var(--bg); outline: none; transition: border-color .15s;
}
.f-search input:focus { border-color: var(--blue); }
.f-select {
  padding: 8px 12px; border: 1px solid var(--border); border-radius: 7px;
  font-family: inherit; font-size: .875rem; color: var(--text);
  background: var(--bg); outline: none; cursor: pointer; min-width: 160px;
  transition: border-color .15s;
}
.f-select:focus { border-color: var(--blue); }
.btn-filter {
  padding: 8px 18px; background: var(--blue); color: #fff;
  border: none; border-radius: 7px; font-family: inherit;
  font-size: .875rem; font-weight: 600; cursor: pointer;
  transition: background .15s;
}
.btn-filter:hover { background: var(--blue2); }
.btn-reset {
  padding: 8px 14px; background: none; color: var(--muted);
  border: 1px solid var(--border); border-radius: 7px;
  font-family: inherit; font-size: .875rem; cursor: pointer;
  text-decoration: none; display: inline-flex; align-items: center; gap: 5px;
}
.btn-reset:hover { border-color: var(--slate); color: var(--text); }

/* ── 3.3 Barre d'actions groupées ── */
.bulk-bar {
  background: var(--navy);
  border-radius: var(--r); padding: 11px 18px;
  display: none; align-items: center; gap: 10px;
  margin-bottom: 16px; flex-wrap: wrap;
}
.bulk-bar.on { display: flex; }
.bulk-count { font-size: .875rem; font-weight: 600; color: #fff; flex: 1; }
.btn-bulk {
  padding: 7px 16px; border-radius: 7px; border: none;
  font-family: inherit; font-size: .8rem; font-weight: 600;
  cursor: pointer; display: inline-flex; align-items: center; gap: 6px;
  transition: opacity .15s;
}
.btn-bulk:hover { opacity: .85; }
.btn-bulk-gen  { background: #059669; color: #fff; }
.btn-bulk-prev { background: rgba(255,255,255,.15); color: #fff; border: 1px solid rgba(255,255,255,.3) !important; }
.btn-bulk-pub  { background: var(--blue); color: #fff; }
.btn-bulk-none { background: transparent; color: #94A3B8; border: 1px solid #334155 !important; font-size: .75rem; }

/* ── 3.1 + 3.2 Grille ── */
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
  gap: 16px;
}

/* ── Carte étudiant ── */
.s-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--r);
  box-shadow: var(--sh);
  display: flex; overflow: hidden;
  transition: transform .15s, box-shadow .15s;
  position: relative;
}
.s-card:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(15,23,42,.1); }
.s-card.selected { border-color: var(--blue); box-shadow: 0 0 0 2px rgba(59,130,246,.25); }

/* Bande colorée gauche = statut diplôme */
.s-strip { width: 4px; flex-shrink: 0; }
.s-strip.published { background: var(--green); }
.s-strip.draft     { background: var(--amber); }
.s-strip.none      { background: var(--border); }

/* Checkbox */
.s-check {
  position: absolute; top: 11px; left: 12px; z-index: 2;
}
.s-check input {
  width: 15px; height: 15px; accent-color: var(--blue); cursor: pointer;
}

.s-body { padding: 15px 15px 14px 30px; flex: 1; min-width: 0; }

/* Ligne haute */
.s-top { display: flex; align-items: flex-start; gap: 10px; }
.s-avatar {
  width: 40px; height: 40px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-family: 'Sora', sans-serif; font-size: .85rem; font-weight: 800;
  color: #fff; flex-shrink: 0;
}
.s-info { flex: 1; min-width: 0; }
.s-name {
  font-weight: 700; font-size: .9rem; color: var(--text);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.s-sub { font-size: .72rem; color: var(--muted); margin-top: 1px; }

/* Badge statut */
.s-badge {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 3px 8px; border-radius: 99px;
  font-size: .68rem; font-weight: 700; white-space: nowrap; flex-shrink: 0;
}
.s-badge.published { background: #D1FAE5; color: #065F46; }
.s-badge.draft     { background: #FEF3C7; color: #92400E; }
.s-badge.none      { background: #F1F5F9; color: var(--muted); }
.s-dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }

/* Infos secondaires */
.s-meta {
  display: flex; gap: 14px; margin-top: 12px;
  padding-top: 11px; border-top: 1px solid var(--border);
}
.s-meta-item .lbl { font-size: .65rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
.s-meta-item .val { font-size: .8rem; font-weight: 600; color: var(--text); margin-top: 1px; }

/* Actions */
.s-actions { display: flex; gap: 5px; margin-top: 12px; flex-wrap: wrap; }
.btn-a {
  flex: 1; min-width: 72px;
  padding: 6px 8px; border-radius: 6px;
  border: 1px solid var(--border); background: var(--card);
  font-family: inherit; font-size: .72rem; font-weight: 600;
  color: var(--muted); cursor: pointer; text-align: center;
  text-decoration: none; display: inline-flex; align-items: center;
  justify-content: center; gap: 4px;
  transition: background .12s, color .12s, border-color .12s;
}
.btn-a:hover { background: var(--bg); color: var(--text); }
.btn-a.voir:hover      { border-color: var(--slate); }
.btn-a.generer         { border-color: #059669; color: #059669; }
.btn-a.generer:hover   { background: #D1FAE5; }
.btn-a.visu            { border-color: var(--blue); color: var(--blue); }
.btn-a.visu:hover      { background: #EFF6FF; }
.btn-a.publier         { background: var(--blue); color: #fff; border-color: var(--blue); }
.btn-a.publier:hover   { background: var(--blue2); }

/* Form inline pour publier (POST) */
.publish-form { flex: 1; display: flex; }
.publish-form .btn-a { width: 100%; }

/* ── Empty ── */
.empty {
  text-align: center; padding: 72px 20px;
  grid-column: 1 / -1;
}
.empty svg { margin-bottom: 14px; color: var(--slate); opacity: .5; }
.empty h3  { font-weight: 700; font-size: 1rem; color: var(--text); }
.empty p   { font-size: .875rem; color: var(--muted); margin-top: 5px; }

/* ── Responsive ── */
@media (max-width: 600px) {
  .page-header, .wrap { padding-left: 16px; padding-right: 16px; }
  .filter-card { gap: 8px; }
  .f-select { min-width: unset; }
}
</style>
{% endblock %}

{% block body %}

{# ── En-tête avec KPIs ── #}
<div class="page-header">
  <h1>Étudiants certifiés</h1>
  <p>Gérez les diplômes de chaque étudiant — générez, visualisez, publiez.</p>
  <div class="kpi-row">
    {% set nb_total     = certified_students|length %}
    {% set nb_published = certified_students|filter(s => s.diploma is not null and s.diploma.isValid)|length %}
    {% set nb_draft     = certified_students|filter(s => s.diploma is not null and not s.diploma.isValid)|length %}
    {% set nb_none      = certified_students|filter(s => s.diploma is null)|length %}
    <div class="kpi"><div class="kpi-val">{{ nb_total }}</div><div class="kpi-lbl">Total</div></div>
    <div class="kpi"><div class="kpi-val" style="color:#6EE7B7">{{ nb_published }}</div><div class="kpi-lbl">Publiés</div></div>
    <div class="kpi"><div class="kpi-val" style="color:#FCD34D">{{ nb_draft }}</div><div class="kpi-lbl">En attente</div></div>
    <div class="kpi"><div class="kpi-val" style="color:#93C5FD">{{ nb_none }}</div><div class="kpi-lbl">Sans diplôme</div></div>
  </div>
</div>

<div class="wrap">

  {# ── Flash messages ── #}
  {% if app.flashes|length > 0 %}
    <div class="flashes">
      {% for type, msgs in app.flashes %}
        {% for msg in msgs %}
          <div class="flash flash-{{ type }}">{{ msg }}</div>
        {% endfor %}
      {% endfor %}
    </div>
  {% endif %}

  {# ── 3.6 Filtre ── #}
  <form method="get" action="{{ path('app_client_student_list') }}" id="filter-form">
    <div class="filter-card">
      <label>Filtrer</label>

      <div class="f-search">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        <input type="text" name="search"
               placeholder="Rechercher un étudiant…"
               value="{{ filter.search }}">
      </div>

      <select name="speciality" class="f-select" onchange="document.getElementById('filter-form').submit()">
        <option value="">Toutes les spécialités</option>
        {% for sp in specialities %}
          <option value="{{ sp.id }}" {% if filter.speciality == sp.id|string %}selected{% endif %}>
            {{ sp.label }}
          </option>
        {% endfor %}
      </select>

      <select name="diploma_state" class="f-select" onchange="document.getElementById('filter-form').submit()">
        <option value="">Tous les statuts</option>
        <option value="published" {% if filter.diploma_state == 'published' %}selected{% endif %}>✅ Diplôme publié</option>
        <option value="draft"     {% if filter.diploma_state == 'draft'     %}selected{% endif %}>⏳ En attente</option>
        <option value="none"      {% if filter.diploma_state == 'none'      %}selected{% endif %}>— Sans diplôme</option>
      </select>

      <button type="submit" class="btn-filter">Filtrer</button>

      {% if filter.search or filter.speciality or filter.diploma_state %}
        <a href="{{ path('app_client_student_list') }}" class="btn-reset">
          <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path d="M18 6 6 18M6 6l12 12"/>
          </svg>
          Effacer
        </a>
      {% endif %}
    </div>
  </form>

  {# ── 3.3 Barre sélection groupée ── #}
  <form method="post" action="{{ path('app_client_student_select') }}" id="bulk-form">
    <input type="hidden" name="_token" value="{{ csrf_token('bulk_action') }}">

    <div class="bulk-bar" id="bulk-bar">
      <span class="bulk-count" id="bulk-count">0 sélectionné(s)</span>

      {# 3.4 Générer en masse #}
      <button type="submit" name="bulk_action" value="generate" class="btn-bulk btn-bulk-gen">
        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
          <line x1="12" y1="18" x2="12" y2="12"/>
          <line x1="9" y1="15" x2="15" y2="15"/>
        </svg>
        Générer les diplômes
      </button>

      {# 3.5 Visualiser en masse #}
      <button type="submit" name="bulk_action" value="preview" class="btn-bulk btn-bulk-prev">
        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
        </svg>
        Visualiser
      </button>

      {# 3.5 Publier en masse #}
      <button type="submit" name="bulk_action" value="publish" class="btn-bulk btn-bulk-pub">
        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
          <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        Publier
      </button>

      <button type="button" onclick="deselectAll()" class="btn-bulk btn-bulk-none">
        Tout désélectionner
      </button>
    </div>

    {# ── 3.1 + 3.2 Grille de cartes ── #}
    {% set palette = ['#3B82F6','#8B5CF6','#059669','#D97706','#DC2626','#0891B2','#DB2777','#4F46E5'] %}

    <div class="grid">
      {% if certified_students is empty %}
        <div class="empty">
          <svg width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
          <h3>Aucun étudiant trouvé</h3>
          <p>Modifiez vos critères de recherche pour voir des résultats.</p>
        </div>
      {% else %}
        {% for student in certified_students %}
          {% set color    = palette[loop.index0 % palette|length] %}
          {% set diploma  = student.diploma ?? null %}
          {% set initials = student.firstName|first|upper ~ student.lastName|first|upper %}

          {# Statut diplôme #}
          {% if diploma is not null and diploma.isValid %}
            {% set strip = 'published' %}
            {% set badge = 'published' %}
            {% set label = 'Publié' %}
          {% elseif diploma is not null %}
            {% set strip = 'draft' %}
            {% set badge = 'draft' %}
            {% set label = 'En attente' %}
          {% else %}
            {% set strip = 'none' %}
            {% set badge = 'none' %}
            {% set label = 'Sans diplôme' %}
          {% endif %}

          <div class="s-card" id="card-{{ student.id }}">
            {# Bande latérale statut #}
            <div class="s-strip {{ strip }}"></div>

            {# 3.3 Checkbox sélection #}
            <div class="s-check">
              <input type="checkbox"
                     name="student_ids[]"
                     value="{{ student.id }}"
                     class="cb-student"
                     aria-label="Sélectionner {{ student.firstName }} {{ student.lastName }}">
            </div>

            <div class="s-body">
              {# 3.2 Infos étudiant #}
              <div class="s-top">
                <div class="s-avatar" style="background: {{ color }}">{{ initials }}</div>
                <div class="s-info">
                  <div class="s-name">{{ student.firstName }} {{ student.lastName }}</div>
                  <div class="s-sub">{{ student.training.speciality.label ?? 'Spécialité —' }}</div>
                </div>
                <span class="s-badge {{ badge }}">
                  <span class="s-dot"></span>{{ label }}
                </span>
              </div>

              <div class="s-meta">
                <div class="s-meta-item">
                  <div class="lbl">Niveau</div>
                  <div class="val">{{ student.training.label ?? '—' }}</div>
                </div>
                <div class="s-meta-item">
                  <div class="lbl">Promotion</div>
                  <div class="val">{{ student.graduationDate ? student.graduationDate|date('Y') : '—' }}</div>
                </div>
                {% if diploma %}
                  <div class="s-meta-item">
                    <div class="lbl">Généré le</div>
                    <div class="val">{{ diploma.generatedAt|date('d/m/Y') }}</div>
                  </div>
                {% endif %}
              </div>

              {# Actions par carte #}
              <div class="s-actions">
                {# 3.2 Voir la fiche #}
                <a href="{{ path('app_client_student_show', {id: student.id}) }}" class="btn-a voir">
                  <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                    <circle cx="12" cy="12" r="3"/>
                  </svg>
                  Voir
                </a>

                {% if diploma is null %}
                  {# 3.4 Générer le diplôme #}
                  <a href="{{ path('app_client_student_generate_diploma', {id: student.id}) }}" class="btn-a generer">
                    <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                      <polyline points="14 2 14 8 20 8"/>
                      <line x1="12" y1="18" x2="12" y2="12"/>
                      <line x1="9" y1="15" x2="15" y2="15"/>
                    </svg>
                    Générer
                  </a>
                {% else %}
                  {# 3.5 Visualiser (toujours dispo si diplôme existe) #}
                  <a href="{{ path('app_client_student_diploma_preview', {id: student.id}) }}" class="btn-a visu">
                    <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                      <polyline points="14 2 14 8 20 8"/>
                    </svg>
                    Visualiser
                  </a>

                  {# 3.5 Publier (uniquement si isValid = false) #}
                  {% if not diploma.isValid %}
                    <form method="post"
                          action="{{ path('app_client_student_diploma_publish', {id: student.id}) }}"
                          class="publish-form"
                          onsubmit="return confirm('Publier le diplôme de {{ student.firstName }} {{ student.lastName }} ?')">
                      <input type="hidden" name="_token" value="{{ csrf_token('publish_' ~ student.id) }}">
                      <button type="submit" class="btn-a publier">
                        <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                          <polyline points="22 4 12 14.01 9 11.01"/>
                        </svg>
                        Publier
                      </button>
                    </form>
                  {% endif %}
                {% endif %}
              </div>{# /s-actions #}
            </div>{# /s-body #}
          </div>{# /s-card #}
        {% endfor %}
      {% endif %}
    </div>{# /grid #}

  </form>{# /bulk-form #}

</div>{# /wrap #}

<script>
(function () {
  const bar      = document.getElementById('bulk-bar');
  const countEl  = document.getElementById('bulk-count');
  const cbs      = document.querySelectorAll('.cb-student');

  function update() {
    const checked = [...cbs].filter(c => c.checked);
    countEl.textContent = checked.length + ' sélectionné(s)';
    bar.classList.toggle('on', checked.length > 0);
    // Highlight card
    cbs.forEach(cb => {
      const card = document.getElementById('card-' + cb.value);
      if (card) card.classList.toggle('selected', cb.checked);
    });
  }

  cbs.forEach(cb => cb.addEventListener('change', update));

  window.deselectAll = function () {
    cbs.forEach(cb => { cb.checked = false; });
    update();
  };
})();
</script>
{% endblock %}
