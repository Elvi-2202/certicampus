{% extends 'base.html.twig' %}

{% block title %}Inscription — CertiCampus{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --ink: #0f1117; --ink-soft: #4a4f5e; --paper: #faf9f6;
    --gold: #c8a96e; --teal: #1e6b72; --teal-light: #e8f4f5;
    --danger: #c0392b; --green: #16a34a; --radius: 10px; --transition: 0.22s ease;
  }
  body { font-family: 'DM Sans', sans-serif; background: var(--paper); color: var(--ink); min-height: 100vh; }
  .auth-shell { display: grid; grid-template-columns: 1fr 1fr; min-height: 100vh; }

  /* ── Panel gauche ── */
  .auth-panel { background: var(--teal); position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; padding: 3rem; }
  .auth-panel::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 80% 60% at 20% 80%, rgba(200,169,110,.18) 0%, transparent 70%), radial-gradient(ellipse 60% 50% at 80% 10%, rgba(255,255,255,.07) 0%, transparent 60%); }
  .auth-panel__logo { position: relative; display: flex; align-items: center; gap: .75rem; text-decoration: none; }
  .auth-panel__logo-mark { width: 40px; height: 40px; background: var(--gold); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-family: 'DM Serif Display', serif; font-size: 1.3rem; color: var(--ink); }
  .auth-panel__logo-text { font-family: 'DM Serif Display', serif; font-size: 1.5rem; color: #fff; }
  .auth-panel__content { position: relative; }
  .auth-panel__eyebrow { display: inline-block; font-size: .7rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--gold); margin-bottom: 1.25rem; }
  .auth-panel__headline { font-family: 'DM Serif Display', serif; font-size: clamp(2rem, 3.5vw, 2.8rem); color: #fff; line-height: 1.15; margin-bottom: 1.5rem; }
  .auth-panel__headline em { font-style: italic; color: var(--gold); }
  .auth-panel__sub { font-size: .95rem; color: rgba(255,255,255,.65); line-height: 1.7; max-width: 30ch; }
  .auth-panel__features { position: relative; display: flex; flex-direction: column; gap: .75rem; margin-top: 2.5rem; }
  .feature-pill { display: flex; align-items: center; gap: .75rem; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.12); border-radius: 50px; padding: .55rem 1rem .55rem .6rem; width: fit-content; }
  .feature-pill__dot { width: 28px; height: 28px; background: var(--gold); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: .85rem; flex-shrink: 0; }
  .feature-pill__text { font-size: .82rem; font-weight: 500; color: rgba(255,255,255,.85); }
  .auth-panel__footer { position: relative; font-size: .78rem; color: rgba(255,255,255,.35); }

  /* ── Formulaire ── */
  .auth-form-wrap { display: flex; align-items: center; justify-content: center; padding: 3rem 2rem; background: var(--paper); }
  .auth-form-box { width: 100%; max-width: 420px; animation: fade-up .4s ease both; }
  @keyframes fade-up { from { opacity:0; transform:translateY(20px); } to { opacity:1; transform:translateY(0); } }
  .auth-form-box__title { font-family: 'DM Serif Display', serif; font-size: 2rem; color: var(--ink); margin-bottom: .4rem; letter-spacing: -.02em; }
  .auth-form-box__sub { font-size: .9rem; color: var(--ink-soft); margin-bottom: 2rem; }
  .auth-form-box__sub a { color: var(--teal); text-decoration: none; font-weight: 500; border-bottom: 1px solid transparent; transition: border-color var(--transition); }
  .auth-form-box__sub a:hover { border-bottom-color: var(--teal); }

  /* ── Erreurs globales ── */
  .form-errors-box { background: #fdf0ef; border: 1px solid #f3c6c3; border-radius: var(--radius); padding: .75rem 1rem; margin-bottom: 1.25rem; }
  .form-errors-box p { font-size: .82rem; color: var(--danger); display: flex; align-items: center; gap: .4rem; }
  .form-errors-box p + p { margin-top: .3rem; }

  /* ── Champs ── */
  .field-row { margin-bottom: 1.1rem; }
  .field-row label { display: block; font-size: .8rem; font-weight: 600; letter-spacing: .03em; color: var(--ink); margin-bottom: .4rem; text-transform: uppercase; }
  .field-row input[type="text"],
  .field-row input[type="email"],
  .field-row input[type="password"] {
    width: 100%; padding: .75rem 1rem; border: 1.5px solid #ddd9d1; border-radius: var(--radius);
    background: #fff; font-family: 'DM Sans', sans-serif; font-size: .95rem; color: var(--ink);
    outline: none; transition: border-color var(--transition), box-shadow var(--transition);
  }
  .field-row input:focus { border-color: var(--teal); box-shadow: 0 0 0 3px var(--teal-light); }
  .field-row input.is-invalid,
  .field-has-error input { border-color: var(--danger) !important; }

  /* ── Message d'erreur champ ── */
  .field-error-msg { font-size: .78rem; color: var(--danger); margin-top: .35rem; display: flex; align-items: center; gap: .3rem; }
  .field-error-msg::before { content: '⚠'; font-size: .8rem; }

  .field-duo { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }

  /* ── Checkbox ── */
  .checkbox-row { display: flex; align-items: flex-start; gap: .65rem; margin-bottom: 1.5rem; }
  .checkbox-row input[type="checkbox"] { appearance: none; width: 18px; height: 18px; border: 1.5px solid #ddd9d1; border-radius: 4px; background: #fff; cursor: pointer; flex-shrink: 0; margin-top: 2px; display: grid; place-items: center; transition: background var(--transition), border-color var(--transition); }
  .checkbox-row input[type="checkbox"]:checked { background: var(--teal); border-color: var(--teal); }
  .checkbox-row input[type="checkbox"]:checked::after { content: ''; display: block; width: 5px; height: 9px; border: 2px solid #fff; border-top: none; border-left: none; transform: rotate(45deg) translate(-1px, -1px); }
  .checkbox-row label { font-size: .875rem; color: var(--ink-soft); cursor: pointer; line-height: 1.5; }

  /* ── Bouton ── */
  .btn-submit { width: 100%; padding: .9rem 1.5rem; background: var(--teal); color: #fff; border: none; border-radius: var(--radius); font-family: 'DM Sans', sans-serif; font-size: 1rem; font-weight: 600; cursor: pointer; transition: background var(--transition); }
  .btn-submit:hover { background: #185960; }

  /* ── Indicateur de force ── */
  .pw-wrap { position: relative; }
  .pw-wrap input { padding-right: 2.8rem !important; }
  .pw-toggle { position: absolute; right: .85rem; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; font-size: 1rem; color: var(--ink-soft); }
  .pw-strength-bar { display: flex; gap: 4px; margin-top: .5rem; margin-bottom: .3rem; }
  .pw-strength-bar span { flex: 1; height: 4px; border-radius: 99px; background: #e4e0d9; transition: background .25s; }
  .pw-strength-label { font-size: .72rem; color: #9ca3af; }
  .pw-rules { margin-top: .5rem; display: flex; flex-direction: column; gap: .25rem; }
  .pw-rule { display: flex; align-items: center; gap: .4rem; font-size: .75rem; color: #9ca3af; transition: color .2s; }
  .pw-rule.ok  { color: var(--green); }
  .pw-rule.err { color: var(--danger); }

  @media (max-width: 820px) { .auth-shell { grid-template-columns: 1fr; } .auth-panel { display: none; } .auth-form-wrap { padding: 2.5rem 1.25rem; } }
</style>
{% endblock %}

{% block body %}
<div class="auth-shell">

  <aside class="auth-panel">
    <a href="{{ path('app_admin_dashboard') }}" class="auth-panel__logo">
      <div class="auth-panel__logo-mark">C</div>
      <span class="auth-panel__logo-text">CertiCampus</span>
    </a>
    <div class="auth-panel__content">
      <span class="auth-panel__eyebrow">Formation professionnelle</span>
      <h2 class="auth-panel__headline">Obtenez vos<br>certifications<br><em>avec confiance.</em></h2>
      <p class="auth-panel__sub">Rejoignez des milliers d'apprenants qui développent leurs compétences et valident leur expertise.</p>
      <div class="auth-panel__features">
        <div class="feature-pill"><div class="feature-pill__dot">🎓</div><span class="feature-pill__text">Certifications reconnues</span></div>
        <div class="feature-pill"><div class="feature-pill__dot">📊</div><span class="feature-pill__text">Suivi de progression en temps réel</span></div>
        <div class="feature-pill"><div class="feature-pill__dot">🔐</div><span class="feature-pill__text">Accès sécurisé à vos résultats</span></div>
      </div>
    </div>
    <p class="auth-panel__footer">© {{ "now"|date("Y") }} CertiCampus — Tous droits réservés</p>
  </aside>

  <main class="auth-form-wrap">
    <div class="auth-form-box">

      <h1 class="auth-form-box__title">Créer un compte</h1>
      <p class="auth-form-box__sub">Déjà inscrit ? <a href="{{ path('app_login') }}">Se connecter</a></p>


      {{ form_start(registrationForm, {'attr': {'novalidate': 'novalidate', 'id': 'reg-form'}}) }}

        <div class="field-duo">
          <div class="field-row {% if not registrationForm.firstname.vars.valid and registrationForm.vars.submitted %}field-has-error{% endif %}">
            {{ form_label(registrationForm.firstname, 'Prénom') }}
            {{ form_widget(registrationForm.firstname, {'attr': {'placeholder': 'Marie'}}) }}
            {% for error in registrationForm.firstname.vars.errors %}
              <div class="field-error-msg">{{ error.message }}</div>
            {% endfor %}
          </div>
          <div class="field-row {% if not registrationForm.lastname.vars.valid and registrationForm.vars.submitted %}field-has-error{% endif %}">
            {{ form_label(registrationForm.lastname, 'Nom') }}
            {{ form_widget(registrationForm.lastname, {'attr': {'placeholder': 'Dupont'}}) }}
            {% for error in registrationForm.lastname.vars.errors %}
              <div class="field-error-msg">{{ error.message }}</div>
            {% endfor %}
          </div>
        </div>

        <div class="field-row {% if not registrationForm.email.vars.valid and registrationForm.vars.submitted %}field-has-error{% endif %}">
          {{ form_label(registrationForm.email, 'Adresse e-mail') }}
          {{ form_widget(registrationForm.email, {'attr': {'placeholder': 'marie.dupont@exemple.fr'}}) }}
          {% for error in registrationForm.email.vars.errors %}
            <div class="field-error-msg">{{ error.message }}</div>
          {% endfor %}
        </div>

        <div class="field-row {% if not registrationForm.plainPassword.vars.valid and registrationForm.vars.submitted %}field-has-error{% endif %}">
          {{ form_label(registrationForm.plainPassword, 'Mot de passe') }}
          <div class="pw-wrap">
            {{ form_widget(registrationForm.plainPassword, {'attr': {
              'placeholder': '8 caractères min, lettres et chiffres',
              'id': 'plainPassword'
            }}) }}
            <button type="button" class="pw-toggle" onclick="
              const i = document.getElementById('plainPassword');
              const s = i.type === 'password';
              i.type = s ? 'text' : 'password';
              this.textContent = s ? '🙈' : '👁';
            ">👁</button>
          </div>

          {# Erreurs mot de passe — affichées clairement #}
          {% for error in registrationForm.plainPassword.vars.errors %}
            <div class="field-error-msg">{{ error.message }}</div>
          {% endfor %}

          {# Indicateur de force #}
          <div class="pw-strength-bar">
            <span id="bar1"></span><span id="bar2"></span>
            <span id="bar3"></span><span id="bar4"></span>
          </div>
          <div class="pw-strength-label" id="reg-strength-label">Saisissez un mot de passe</div>

          <div class="pw-rules">
            <div class="pw-rule" id="reg-rule-len"><span>○</span> Au moins 8 caractères</div>
            <div class="pw-rule" id="reg-rule-letter"><span>○</span> Au moins une lettre (a-z, A-Z)</div>
            <div class="pw-rule" id="reg-rule-digit"><span>○</span> Au moins un chiffre (0-9)</div>
          </div>
        </div>

        <div class="checkbox-row">
          {{ form_widget(registrationForm.agreeTerms) }}
          {{ form_label(registrationForm.agreeTerms, "J'accepte les conditions d'utilisation") }}
          {% for error in registrationForm.agreeTerms.vars.errors %}
            <div class="field-error-msg">{{ error.message }}</div>
          {% endfor %}
        </div>

        <button type="submit" class="btn-submit">Créer mon compte →</button>

      {{ form_end(registrationForm) }}

    </div>
  </main>
</div>

<script>
(function () {
  const pw    = document.getElementById('plainPassword');
  if (!pw) return;
  const bars  = [1,2,3,4].map(i => document.getElementById('bar' + i));
  const lbl   = document.getElementById('reg-strength-label');
  const rLen  = document.getElementById('reg-rule-len');
  const rLett = document.getElementById('reg-rule-letter');
  const rDig  = document.getElementById('reg-rule-digit');

  const colors = ['#ef4444','#f59e0b','#3b82f6','#16a34a'];
  const labels = ['Très faible','Faible','Moyen','Fort'];

  function setRule(el, ok) {
    el.classList.toggle('ok',  ok);
    el.classList.toggle('err', !ok && pw.value.length > 0);
    el.querySelector('span').textContent = ok ? '✓' : pw.value.length > 0 ? '✗' : '○';
  }

  pw.addEventListener('input', function () {
    const v  = pw.value;
    const l  = v.length >= 8;
    const le = /[a-zA-Z]/.test(v);
    const d  = /[0-9]/.test(v);
    const sy = /[^a-zA-Z0-9]/.test(v);

    setRule(rLen,  l);
    setRule(rLett, le);
    setRule(rDig,  d);

    if (!v) {
      bars.forEach(b => b.style.background = '#e4e0d9');
      lbl.textContent = 'Saisissez un mot de passe';
      lbl.style.color = '#9ca3af';
      return;
    }

    const s = Math.max(0, Math.min(3, [l, le, d, sy].filter(Boolean).length - 1));
    bars.forEach((b, i) => b.style.background = i <= s ? colors[s] : '#e4e0d9');
    lbl.textContent = labels[s];
    lbl.style.color = colors[s];
  });
})();
</script>
{% endblock %}
