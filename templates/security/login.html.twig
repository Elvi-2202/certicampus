{% extends 'base.html.twig' %}

{% block title %}Connexion — CertiCampus{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --ink:       #0f1117;
    --ink-soft:  #4a4f5e;
    --paper:     #faf9f6;
    --cream:     #f0ede6;
    --gold:      #c8a96e;
    --gold-pale: #f5eddc;
    --teal:      #1e6b72;
    --teal-light:#e8f4f5;
    --danger:    #c0392b;
    --radius:    10px;
    --transition: 0.22s ease;
  }

  body {
    font-family: 'DM Sans', sans-serif;
    background-color: var(--paper);
    color: var(--ink);
    min-height: 100vh;
  }

  /* ── Layout ── */
  .auth-shell {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100vh;
  }

  /* ── Right form panel first on login ── */
  .auth-form-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 2rem;
    background: var(--paper);
  }

  .auth-form-box {
    width: 100%;
    max-width: 400px;
    animation: fade-up .4s ease both;
  }

  @keyframes fade-up {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .auth-form-box__badge {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    background: var(--gold-pale);
    border: 1px solid rgba(200,169,110,.3);
    border-radius: 50px;
    padding: .35rem .9rem;
    font-size: .72rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: #8a6a30;
    margin-bottom: 1.5rem;
  }

  .auth-form-box__title {
    font-family: 'DM Serif Display', serif;
    font-size: 2.2rem;
    color: var(--ink);
    margin-bottom: .4rem;
    letter-spacing: -.02em;
    line-height: 1.1;
  }

  .auth-form-box__sub {
    font-size: .9rem;
    color: var(--ink-soft);
    margin-bottom: 2rem;
  }

  .auth-form-box__sub a {
    color: var(--teal);
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px solid transparent;
    transition: border-color var(--transition);
  }

  .auth-form-box__sub a:hover { border-bottom-color: var(--teal); }

  /* ── Alert ── */
  .alert-danger {
    background: #fdf0ef;
    border: 1px solid #f3c6c3;
    border-radius: var(--radius);
    color: var(--danger);
    padding: .75rem 1rem;
    font-size: .875rem;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: .5rem;
  }

  .alert-danger::before { content: '⚠'; font-size: 1rem; }

  .alert-already-logged {
    background: var(--teal-light);
    border: 1px solid rgba(30,107,114,.2);
    border-radius: var(--radius);
    color: var(--teal);
    padding: .75rem 1rem;
    font-size: .875rem;
    margin-bottom: 1.5rem;
  }

  .alert-already-logged a { color: var(--teal); font-weight: 600; }

  /* ── Form fields ── */
  .field-row {
    margin-bottom: 1.1rem;
  }

  .field-row label {
    display: block;
    font-size: .8rem;
    font-weight: 600;
    letter-spacing: .03em;
    color: var(--ink);
    margin-bottom: .4rem;
    text-transform: uppercase;
  }

  .field-row input[type="email"],
  .field-row input[type="password"] {
    width: 100%;
    padding: .75rem 1rem;
    border: 1.5px solid #ddd9d1;
    border-radius: var(--radius);
    background: #fff;
    font-family: 'DM Sans', sans-serif;
    font-size: .95rem;
    color: var(--ink);
    outline: none;
    transition: border-color var(--transition), box-shadow var(--transition);
    appearance: none;
  }

  .field-row input:focus {
    border-color: var(--teal);
    box-shadow: 0 0 0 3px var(--teal-light);
  }

  /* ── Password wrapper with show/hide ── */
  .password-wrap {
    position: relative;
  }

  .password-wrap input { padding-right: 3rem; }

  .password-toggle {
    position: absolute;
    right: .85rem;
    top: 50%; transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1;
    padding: .2rem;
    transition: color var(--transition);
  }

  .password-toggle:hover { color: var(--teal); }

  /* ── Remember me + forgot ── */
  .form-footer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    margin-top: .25rem;
  }

  .remember-label {
    display: flex;
    align-items: center;
    gap: .5rem;
    cursor: pointer;
    font-size: .875rem;
    color: var(--ink-soft);
    user-select: none;
  }

  .remember-label input[type="checkbox"] {
    appearance: none;
    width: 17px; height: 17px;
    border: 1.5px solid #ddd9d1;
    border-radius: 4px;
    background: #fff;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background var(--transition), border-color var(--transition);
    flex-shrink: 0;
  }

  .remember-label input[type="checkbox"]:checked {
    background: var(--teal);
    border-color: var(--teal);
  }

  .remember-label input[type="checkbox"]:checked::after {
    content: '';
    display: block;
    width: 4px; height: 8px;
    border: 2px solid #fff;
    border-top: none; border-left: none;
    transform: rotate(45deg) translate(-1px, -1px);
  }

  .forgot-link {
    font-size: .82rem;
    color: var(--teal);
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px solid transparent;
    transition: border-color var(--transition);
  }

  .forgot-link:hover { border-bottom-color: var(--teal); }

  /* ── Submit ── */
  .btn-submit {
    width: 100%;
    padding: .9rem 1.5rem;
    background: var(--teal);
    color: #fff;
    border: none;
    border-radius: var(--radius);
    font-family: 'DM Sans', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    letter-spacing: .01em;
    transition: background var(--transition), transform var(--transition), box-shadow var(--transition);
    position: relative;
    overflow: hidden;
  }

  .btn-submit::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent 30%, rgba(255,255,255,.12) 50%, transparent 70%);
    transform: translateX(-100%);
    transition: transform .5s ease;
  }

  .btn-submit:hover { background: #185960; box-shadow: 0 4px 18px rgba(30,107,114,.3); }
  .btn-submit:hover::after { transform: translateX(100%); }
  .btn-submit:active { transform: scale(.98); }

  /* ── Left panel ── */
  .auth-panel {
    background-color: var(--ink);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 3rem;
    order: 2; /* Panel on the right for login */
  }

  .auth-panel::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 50% at 80% 20%, rgba(30,107,114,.35) 0%, transparent 60%),
      radial-gradient(ellipse 60% 70% at 10% 90%, rgba(200,169,110,.12) 0%, transparent 60%);
  }

  /* Decorative grid lines */
  .auth-panel::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
    background-size: 40px 40px;
  }

  .auth-panel__logo {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: .75rem;
    text-decoration: none;
  }

  .auth-panel__logo-mark {
    width: 40px; height: 40px;
    background: var(--gold);
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-family: 'DM Serif Display', serif;
    font-size: 1.3rem;
    color: var(--ink);
  }

  .auth-panel__logo-text {
    font-family: 'DM Serif Display', serif;
    font-size: 1.5rem;
    color: #fff;
    letter-spacing: -.01em;
  }

  .auth-panel__content {
    position: relative;
    z-index: 1;
  }

  .auth-panel__quote {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(1.6rem, 2.5vw, 2.2rem);
    color: #fff;
    line-height: 1.25;
    margin-bottom: 1.25rem;
  }

  .auth-panel__quote em {
    color: var(--gold);
    font-style: italic;
  }

  .auth-panel__quote-attr {
    font-size: .82rem;
    color: rgba(255,255,255,.4);
    letter-spacing: .05em;
  }

  .auth-panel__stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .stat-card {
    background: rgba(255,255,255,.05);
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 12px;
    padding: 1rem 1.1rem;
    animation: fade-up .5s ease both;
  }

  .stat-card:nth-child(2) { animation-delay: .1s; }
  .stat-card:nth-child(3) { animation-delay: .2s; }
  .stat-card:nth-child(4) { animation-delay: .3s; }

  .stat-card__number {
    font-family: 'DM Serif Display', serif;
    font-size: 1.8rem;
    color: var(--gold);
    line-height: 1;
    margin-bottom: .25rem;
  }

  .stat-card__label {
    font-size: .75rem;
    color: rgba(255,255,255,.45);
    font-weight: 500;
    line-height: 1.4;
  }

  .auth-panel__footer {
    position: relative;
    z-index: 1;
    font-size: .78rem;
    color: rgba(255,255,255,.25);
  }

  /* ── Responsive ── */
  @media (max-width: 820px) {
    .auth-shell { grid-template-columns: 1fr; }
    .auth-panel { display: none; }
    .auth-form-wrap { padding: 2.5rem 1.25rem; order: 1; }
  }
</style>
{% endblock %}

{% block body %}
<div class="auth-shell">

  {# ── Left form panel ── #}
  <main class="auth-form-wrap">
    <div class="auth-form-box">

      <div class="auth-form-box__badge">
        🔐 Espace sécurisé
      </div>

      <h1 class="auth-form-box__title">Bon retour<br>parmi nous.</h1>
      <p class="auth-form-box__sub">
        Pas encore de compte ? <a href="{{ path('app_register') }}">S'inscrire gratuitement</a>
      </p>

      {% if error %}
        <div class="alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
      {% endif %}

      {% if app.user %}
        <div class="alert-already-logged">
          Vous êtes connecté en tant que <strong>{{ app.user.userIdentifier }}</strong>.
          <a href="{{ logout_path() }}">Se déconnecter</a>
        </div>
      {% endif %}

      <form method="post">

        <div class="field-row">
          <label for="inputEmail">Adresse e-mail</label>
          <input
            type="email"
            value="{{ last_username }}"
            name="email"
            id="inputEmail"
            placeholder="marie.dupont@exemple.fr"
            autocomplete="email"
            required
            autofocus
          >
        </div>

        <div class="field-row">
          <label for="inputPassword">Mot de passe</label>
          <div class="password-wrap">
            <input
              type="password"
              name="password"
              id="inputPassword"
              placeholder="••••••••"
              autocomplete="current-password"
              required
            >
            <button
              type="button"
              class="password-toggle"
              aria-label="Afficher/masquer le mot de passe"
              onclick="
                const i = document.getElementById('inputPassword');
                const show = i.type === 'password';
                i.type = show ? 'text' : 'password';
                this.textContent = show ? '🙈' : '👁';
              "
            >👁</button>
          </div>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <div class="form-footer-row">
          <label class="remember-label">
            <input type="checkbox" name="_remember_me">
            Se souvenir de moi
          </label>
          <a href="#" class="forgot-link">Mot de passe oublié ?</a>
        </div>

        <button class="btn-submit" type="submit">Se connecter →</button>

      </form>

    </div>
  </main>

  {# ── Right decorative panel ── #}
  <aside class="auth-panel">
    <a href="{{ path('app_admin_dashboard') }}" class="auth-panel__logo">
      <div class="auth-panel__logo-mark">C</div>
      <span class="auth-panel__logo-text">CertiCampus</span>
    </a>

    <div class="auth-panel__content">
      <blockquote class="auth-panel__quote">
        « La certification, c'est la preuve que<br>
        <em>l'effort rencontre l'excellence.</em> »
      </blockquote>
      <p class="auth-panel__quote-attr">— La philosophie CertiCampus</p>

      <div class="auth-panel__stats">
        <div class="stat-card">
          <div class="stat-card__number">12k+</div>
          <div class="stat-card__label">Apprenants certifiés</div>
        </div>
        <div class="stat-card">
          <div class="stat-card__number">98%</div>
          <div class="stat-card__label">Taux de satisfaction</div>
        </div>
        <div class="stat-card">
          <div class="stat-card__number">240</div>
          <div class="stat-card__label">Certifications disponibles</div>
        </div>
        <div class="stat-card">
          <div class="stat-card__number">4.9★</div>
          <div class="stat-card__label">Note moyenne</div>
        </div>
      </div>
    </div>

    <p class="auth-panel__footer">© {{ "now"|date("Y") }} CertiCampus — Tous droits réservés</p>
  </aside>

</div>
{% endblock %}
