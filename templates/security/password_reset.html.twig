{% extends 'base.html.twig' %}

{% block title %}Récupérer mon mot de passe — Certicampus{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --ink:       #0f1117;
    --ink-soft:  #4a4f5e;
    --paper:     #faf9f6;
    --gold:      #c8a96e;
    --gold-pale: #f5eddc;
    --teal:      #1e6b72;
    --teal-light:#e8f4f5;
    --danger:    #c0392b;
    --radius:    10px;
    --transition: 0.22s ease;
  }
  body { font-family: 'DM Sans', sans-serif; background: var(--paper); color: var(--ink); min-height: 100vh; }
  .auth-shell { display: grid; grid-template-columns: 1fr 1fr; min-height: 100vh; }
  .auth-form-wrap { display: flex; align-items: center; justify-content: center; padding: 3rem 2rem; background: var(--paper); }
  .auth-form-box { width: 100%; max-width: 400px; animation: fade-up .4s ease both; }
  @keyframes fade-up { from { opacity:0; transform:translateY(20px); } to { opacity:1; transform:translateY(0); } }
  .auth-form-box__title { font-family: 'DM Serif Display', serif; font-size: 2.2rem; color: var(--ink); margin-bottom: 1rem; letter-spacing: -.02em; line-height: 1.1; }
  .auth-form-box__sub { font-size: .9rem; color: var(--ink-soft); margin-bottom: 2rem; line-height: 1.6; }
  .auth-form-box__sub a { color: var(--teal); text-decoration: none; font-weight: 500; border-bottom: 1px solid transparent; transition: border-color var(--transition); }
  .auth-form-box__sub a:hover { border-bottom-color: var(--teal); }
  .alert { border-radius: var(--radius); padding: .85rem 1rem; font-size: .875rem; margin-bottom: 1.5rem; display: flex; align-items: flex-start; gap: .5rem; }
  .alert-success { background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; }
  .alert-success::before { content: '✓'; font-size: 1.1rem; font-weight: bold; }
  .alert-danger  { background: #fdf0ef; border: 1px solid #f3c6c3; color: var(--danger); }
  .alert-danger::before  { content: '⚠'; }
  .field-row { margin-bottom: 1.5rem; }
  .field-row label { display: block; font-size: .8rem; font-weight: 600; letter-spacing: .03em; color: var(--ink); margin-bottom: .4rem; text-transform: uppercase; }
  .field-row input[type="email"] { width: 100%; padding: .75rem 1rem; border: 1.5px solid #ddd9d1; border-radius: var(--radius); background: #fff; font-family: 'DM Sans', sans-serif; font-size: .95rem; color: var(--ink); outline: none; transition: border-color var(--transition), box-shadow var(--transition); }
  .field-row input:focus { border-color: var(--teal); box-shadow: 0 0 0 3px var(--teal-light); }
  .btn-submit { width: 100%; padding: .9rem 1.5rem; background: var(--teal); color: #fff; border: none; border-radius: var(--radius); font-family: 'DM Sans', sans-serif; font-size: 1rem; font-weight: 600; cursor: pointer; transition: background var(--transition), transform var(--transition); }
  .btn-submit:hover { background: #185960; }
  .btn-submit:active { transform: scale(.98); }
  .btn-submit:disabled { opacity: .6; cursor: not-allowed; }
  .btn-back { display: inline-flex; align-items: center; gap: .4rem; font-size: .85rem; color: var(--teal); text-decoration: none; font-weight: 500; margin-bottom: 1.5rem; }
  .auth-panel { background-color: var(--ink); position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; padding: 3rem; order: 2; }
  .auth-panel::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 70% 50% at 80% 20%, rgba(30,107,114,.35) 0%, transparent 60%), radial-gradient(ellipse 60% 70% at 10% 90%, rgba(200,169,110,.12) 0%, transparent 60%); }
  .auth-panel::after { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px); background-size: 40px 40px; }
  .auth-panel__logo { position: relative; z-index: 1; display: flex; align-items: center; gap: .75rem; text-decoration: none; }
  .auth-panel__logo-mark { width: 40px; height: 40px; background: var(--gold); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-family: 'DM Serif Display', serif; font-size: 1.3rem; color: var(--ink); }
  .auth-panel__logo-text { font-family: 'DM Serif Display', serif; font-size: 1.5rem; color: #fff; }
  .auth-panel__content { position: relative; z-index: 1; }
  .auth-panel__quote { font-family: 'DM Serif Display', serif; font-size: clamp(1.6rem, 2.5vw, 2.2rem); color: #fff; line-height: 1.25; margin-bottom: 1.25rem; }
  .auth-panel__quote em { color: var(--gold); font-style: italic; }
  .auth-panel__quote-attr { font-size: .82rem; color: rgba(255,255,255,.4); letter-spacing: .05em; }
  .auth-panel__footer { position: relative; z-index: 1; font-size: .78rem; color: rgba(255,255,255,.25); }
  @media (max-width: 820px) { .auth-shell { grid-template-columns: 1fr; } .auth-panel { display: none; } .auth-form-wrap { padding: 2.5rem 1.25rem; } }
</style>
{% endblock %}

{% block body %}
<div class="auth-shell">

  <main class="auth-form-wrap">
    <div class="auth-form-box">

      <a href="{{ path('app_login') }}" class="btn-back">← Retour à la connexion</a>

      <h1 class="auth-form-box__title">Récupérer<br>mon mot de passe</h1>
      <p class="auth-form-box__sub">
        Entrez l'adresse e-mail associée à votre compte.
        Nous vous enverrons un lien pour réinitialiser votre mot de passe.
      </p>

      {# Zone messages dynamiques #}
      <div id="alert-zone"></div>

      <form id="resetForm">
        <div class="field-row">
          <label for="email">Adresse e-mail</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="marie.dupont@exemple.fr"
            required
            autofocus
          >
        </div>

        <button class="btn-submit" type="submit" id="submitBtn">
          Envoyer le lien de réinitialisation →
        </button>
      </form>

    </div>
  </main>

  <aside class="auth-panel">
    <a href="{{ path('app_admin_dashboard') }}" class="auth-panel__logo">
      <div class="auth-panel__logo-mark">C</div>
      <span class="auth-panel__logo-text">CertiCampus</span>
    </a>
    <div class="auth-panel__content">
      <blockquote class="auth-panel__quote">
        « La sécurité de vos données<br>
        <em>est notre priorité.</em> »
      </blockquote>
      <p class="auth-panel__quote-attr">— La philosophie CertiCampus</p>
    </div>
    <p class="auth-panel__footer">© {{ "now"|date("Y") }} CertiCampus — Tous droits réservés</p>
  </aside>

</div>

<script>
document.getElementById('resetForm').addEventListener('submit', async function (e) {
  e.preventDefault();

  const email     = document.getElementById('email').value.trim();
  const btn       = document.getElementById('submitBtn');
  const alertZone = document.getElementById('alert-zone');

  // Reset
  alertZone.innerHTML = '';
  btn.disabled = true;
  btn.textContent = 'Envoi en cours…';

  try {
    // URL absolue construite depuis window.location pour éviter les problèmes Docker
    const apiUrl = window.location.origin + '{{ path("api_school_password_reset") }}';

    const response = await fetch(apiUrl, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest',
      },
      body: JSON.stringify({ email }),
    });

    // 204 = succès sans body
    if (response.status === 204 || response.ok) {
      alertZone.innerHTML = `
        <div class="alert alert-success">
          <div>
            <strong>Email envoyé !</strong><br>
            Si cette adresse est associée à un compte, vous recevrez les instructions sous peu.
          </div>
        </div>`;
      document.getElementById('resetForm').style.display = 'none';
      return;
    }

    // Erreur avec body JSON
    let message = 'Une erreur est survenue. Veuillez réessayer.';
    try {
      const data = await response.json();
      if (data.message) message = data.message;
    } catch (_) {}

    alertZone.innerHTML = `<div class="alert alert-danger">${message}</div>`;

  } catch (err) {
    // Erreur réseau réelle — afficher l'URL tentée pour debug
    console.error('Fetch error:', err);
    alertZone.innerHTML = `
      <div class="alert alert-danger">
        Impossible de contacter le serveur. Vérifiez votre connexion et réessayez.
      </div>`;
  } finally {
    btn.disabled = false;
    btn.textContent = 'Envoyer le lien de réinitialisation →';
  }
});
</script>
{% endblock %}
