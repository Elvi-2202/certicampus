{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe — Certicampus{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --ink: #0f1117; --ink-soft: #4a4f5e; --paper: #faf9f6;
    --gold: #c8a96e; --teal: #1e6b72; --teal-light: #e8f4f5;
    --danger: #c0392b; --radius: 10px; --transition: 0.22s ease;
    --green: #16a34a;
  }
  body { font-family: 'DM Sans', sans-serif; background: var(--paper); color: var(--ink); min-height: 100vh; }
  .auth-shell { display: grid; grid-template-columns: 1fr 1fr; min-height: 100vh; }
  .auth-form-wrap { display: flex; align-items: center; justify-content: center; padding: 3rem 2rem; }
  .auth-form-box { width: 100%; max-width: 400px; animation: fade-up .4s ease both; }
  @keyframes fade-up { from { opacity:0; transform:translateY(20px); } to { opacity:1; transform:translateY(0); } }
  .auth-form-box__title { font-family: 'DM Serif Display', serif; font-size: 2.2rem; color: var(--ink); margin-bottom: .5rem; letter-spacing: -.02em; line-height: 1.1; }
  .auth-form-box__sub { font-size: .9rem; color: var(--ink-soft); margin-bottom: 2rem; line-height: 1.6; }
  .alert { border-radius: var(--radius); padding: .85rem 1rem; font-size: .875rem; margin-bottom: 1rem; }
  .alert-danger  { background: #fdf0ef; border: 1px solid #f3c6c3; color: var(--danger); }
  .alert-success { background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; }
  .field-row { margin-bottom: 1.2rem; }
  .field-row label { display: block; font-size: .8rem; font-weight: 600; letter-spacing: .03em; color: var(--ink); margin-bottom: .4rem; text-transform: uppercase; }
  .pw-wrap { position: relative; }
  .pw-wrap input { width: 100%; padding: .75rem 2.8rem .75rem 1rem; border: 1.5px solid #ddd9d1; border-radius: var(--radius); background: #fff; font-family: 'DM Sans', sans-serif; font-size: .95rem; color: var(--ink); outline: none; transition: border-color var(--transition), box-shadow var(--transition); }
  .pw-wrap input:focus { border-color: var(--teal); box-shadow: 0 0 0 3px var(--teal-light); }
  .pw-toggle { position: absolute; right: .85rem; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--ink-soft); font-size: 1rem; padding: .2rem; }
  .pw-toggle:hover { color: var(--teal); }

  /* ── Indicateur de force ── */
  .pw-strength { margin-top: .5rem; }
  .pw-strength-bar { display: flex; gap: 4px; margin-bottom: .35rem; }
  .pw-strength-bar span {
    flex: 1; height: 4px; border-radius: 99px;
    background: #e4e0d9;
    transition: background .25s;
  }
  .pw-strength-label { font-size: .72rem; color: var(--ink-soft); }

  /* ── Règles visuelles ── */
  .pw-rules { margin-top: .6rem; display: flex; flex-direction: column; gap: .3rem; }
  .pw-rule { display: flex; align-items: center; gap: .4rem; font-size: .75rem; color: #9ca3af; transition: color .2s; }
  .pw-rule svg { width: 13px; height: 13px; flex-shrink: 0; }
  .pw-rule.ok  { color: var(--green); }
  .pw-rule.err { color: var(--danger); }

  .btn-submit { width: 100%; padding: .9rem 1.5rem; background: var(--teal); color: #fff; border: none; border-radius: var(--radius); font-family: 'DM Sans', sans-serif; font-size: 1rem; font-weight: 600; cursor: pointer; transition: background var(--transition); margin-top: .5rem; }
  .btn-submit:hover { background: #185960; }
  .btn-back { display: inline-flex; align-items: center; gap: .4rem; font-size: .85rem; color: var(--teal); text-decoration: none; font-weight: 500; margin-bottom: 1.5rem; }
  .auth-panel { background: var(--ink); position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; padding: 3rem; order: 2; }
  .auth-panel::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 70% 50% at 80% 20%, rgba(30,107,114,.35) 0%, transparent 60%); }
  .auth-panel::after  { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px); background-size: 40px 40px; }
  .auth-panel__logo { position: relative; z-index: 1; display: flex; align-items: center; gap: .75rem; text-decoration: none; }
  .auth-panel__logo-mark { width: 40px; height: 40px; background: var(--gold); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-family: 'DM Serif Display', serif; font-size: 1.3rem; color: var(--ink); }
  .auth-panel__logo-text { font-family: 'DM Serif Display', serif; font-size: 1.5rem; color: #fff; }
  .auth-panel__content { position: relative; z-index: 1; }
  .auth-panel__quote { font-family: 'DM Serif Display', serif; font-size: clamp(1.6rem, 2.5vw, 2.2rem); color: #fff; line-height: 1.25; margin-bottom: 1.25rem; }
  .auth-panel__quote em { color: var(--gold); font-style: italic; }
  .auth-panel__footer { position: relative; z-index: 1; font-size: .78rem; color: rgba(255,255,255,.25); }
  @media (max-width: 820px) { .auth-shell { grid-template-columns: 1fr; } .auth-panel { display: none; } }
</style>
{% endblock %}

{% block body %}
<div class="auth-shell">
  <main class="auth-form-wrap">
    <div class="auth-form-box">

      <a href="{{ path('app_login') }}" class="btn-back">← Retour à la connexion</a>

      <h1 class="auth-form-box__title">Nouveau<br>mot de passe</h1>
      <p class="auth-form-box__sub">Choisissez un mot de passe contenant au moins 8 caractères, avec des lettres et des chiffres.</p>

      {% for label, messages in app.flashes %}
        {% for msg in messages %}
          <div class="alert alert-{{ label }}">{{ msg }}</div>
        {% endfor %}
      {% endfor %}

      {% if errors is defined and errors|length > 0 %}
        {% for error in errors %}
          <div class="alert alert-danger">{{ error }}</div>
        {% endfor %}
      {% endif %}

      <form method="post" action="{{ path('app_password_reset_confirm') }}?token={{ token }}">

        <div class="field-row">
          <label for="password">Nouveau mot de passe</label>
          <div class="pw-wrap">
            <input type="password" id="password" name="password" required autofocus>
            <button type="button" class="pw-toggle" onclick="togglePw('password', this)">👁</button>
          </div>

          {# Indicateur de force #}
          <div class="pw-strength">
            <div class="pw-strength-bar">
              <span id="bar1"></span>
              <span id="bar2"></span>
              <span id="bar3"></span>
              <span id="bar4"></span>
            </div>
            <div class="pw-strength-label" id="strength-label">Saisissez un mot de passe</div>
          </div>

          {# Règles visuelles #}
          <div class="pw-rules">
            <div class="pw-rule" id="rule-len">
              <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
              Au moins 8 caractères
            </div>
            <div class="pw-rule" id="rule-letter">
              <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
              Au moins une lettre (a-z, A-Z)
            </div>
            <div class="pw-rule" id="rule-digit">
              <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
              Au moins un chiffre (0-9)
            </div>
          </div>
        </div>

        <div class="field-row">
          <label for="password_confirm">Confirmer le mot de passe</label>
          <div class="pw-wrap">
            <input type="password" id="password_confirm" name="password_confirm" required>
            <button type="button" class="pw-toggle" onclick="togglePw('password_confirm', this)">👁</button>
          </div>
          <div class="pw-rule" id="rule-match" style="margin-top:.4rem">
            <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
            Les mots de passe correspondent
          </div>
        </div>

        <button class="btn-submit" type="submit">Enregistrer le nouveau mot de passe →</button>
      </form>

    </div>
  </main>

  <aside class="auth-panel">
    <a href="{{ path('app_admin_dashboard') }}" class="auth-panel__logo">
      <div class="auth-panel__logo-mark">C</div>
      <span class="auth-panel__logo-text">CertiCampus</span>
    </a>
    <div class="auth-panel__content">
      <blockquote class="auth-panel__quote">
        « La sécurité de vos données<br><em>est notre priorité.</em> »
      </blockquote>
    </div>
    <p class="auth-panel__footer">© {{ "now"|date("Y") }} CertiCampus — Tous droits réservés</p>
  </aside>
</div>

<script>
function togglePw(id, btn) {
  const input = document.getElementById(id);
  const show  = input.type === 'password';
  input.type  = show ? 'text' : 'password';
  btn.textContent = show ? '🙈' : '👁';
}

(function () {
  const pw      = document.getElementById('password');
  const confirm = document.getElementById('password_confirm');
  const bars    = [1,2,3,4].map(i => document.getElementById('bar' + i));
  const label   = document.getElementById('strength-label');
  const rLen    = document.getElementById('rule-len');
  const rLetter = document.getElementById('rule-letter');
  const rDigit  = document.getElementById('rule-digit');
  const rMatch  = document.getElementById('rule-match');

  const colors = ['#ef4444', '#f59e0b', '#3b82f6', '#16a34a'];
  const labels = ['Très faible', 'Faible', 'Moyen', 'Fort'];

  function rule(el, ok) {
    el.classList.toggle('ok',  ok);
    el.classList.toggle('err', !ok && el.classList.contains('ok') === false && pw.value.length > 0);
  }

  function checkStrength(val) {
    const hasLen    = val.length >= 8;
    const hasLetter = /[a-zA-Z]/.test(val);
    const hasDigit  = /[0-9]/.test(val);
    const hasSymbol = /[^a-zA-Z0-9]/.test(val);

    rule(rLen,    hasLen);
    rule(rLetter, hasLetter);
    rule(rDigit,  hasDigit);

    if (!val) {
      bars.forEach(b => b.style.background = '#e4e0d9');
      label.textContent = 'Saisissez un mot de passe';
      label.style.color = '#9ca3af';
      return;
    }

    const score = [hasLen, hasLetter, hasDigit, hasSymbol].filter(Boolean).length - 1;
    const s = Math.max(0, Math.min(3, score));

    bars.forEach((b, i) => {
      b.style.background = i <= s ? colors[s] : '#e4e0d9';
    });
    label.textContent = labels[s];
    label.style.color = colors[s];
  }

  function checkMatch() {
    if (!confirm.value) { rMatch.classList.remove('ok','err'); return; }
    const ok = pw.value === confirm.value;
    rMatch.classList.toggle('ok',  ok);
    rMatch.classList.toggle('err', !ok);
  }

  pw.addEventListener('input',      () => { checkStrength(pw.value); checkMatch(); });
  confirm.addEventListener('input', checkMatch);
})();
</script>
{% endblock %}
