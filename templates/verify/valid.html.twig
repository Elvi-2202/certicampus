{% extends 'base.html.twig' %}

{% block title %}Certificat valide — Certicampus{% endblock %}

{% block body %}
<div style="min-height:100vh; background:#f5f4f0; display:flex; align-items:center; justify-content:center; font-family:'Instrument Sans', sans-serif; padding:2rem;">
    <div style="max-width:750px; width:100%;">

        <div style="text-align:center; margin-bottom:1.5rem;">
            <span style="background:#ecfcd6; color:#3a7a00; padding:6px 16px; border-radius:999px; font-size:13px; font-weight:600;">✅ Certificat authentique vérifié par Certicampus</span>
        </div>

        <div style="
            background:#f5f3eb;
            border: 8px solid #a8b8d8;
            padding: 3rem 2.5rem;
            font-family: Georgia, serif;
            color: #2c3e6b;
            position: relative;
            box-shadow: inset 0 0 0 4px #c5d0e8;
            border-radius: 4px;
        ">
            <div style="position:absolute;top:8px;left:8px;width:30px;height:30px;border-top:3px solid #a8b8d8;border-left:3px solid #a8b8d8;"></div>
            <div style="position:absolute;top:8px;right:8px;width:30px;height:30px;border-top:3px solid #a8b8d8;border-right:3px solid #a8b8d8;"></div>
            <div style="position:absolute;bottom:8px;left:8px;width:30px;height:30px;border-bottom:3px solid #a8b8d8;border-left:3px solid #a8b8d8;"></div>
            <div style="position:absolute;bottom:8px;right:8px;width:30px;height:30px;border-bottom:3px solid #a8b8d8;border-right:3px solid #a8b8d8;"></div>

            <div style="text-align:center;">
                <h2 style="font-size:1.4rem; letter-spacing:2px; text-transform:uppercase; margin-bottom:0.5rem;">Diplôme d'Études Supérieures</h2>
                <p style="font-size:0.95rem; margin-bottom:0.3rem; margin-top:1.5rem;">Le diplôme est remis à</p>
                <div style="font-size:2.2rem; font-style:italic; margin:0.5rem 0;">{{ template.studentName }}</div>
                <p style="font-size:0.85rem; margin:1rem auto; max-width:340px;">
                    Pour avoir terminé avec succès le programme de {{ template.schoolName }}.
                </p>
            </div>

            <div style="display:flex; justify-content:space-between; margin-top:2.5rem; font-size:0.85rem; text-align:center;">
                <div>
                    <strong>{{ template.directorName }}</strong><br>
                    <span style="color:#7a8ab0;">Directeur</span>
                </div>
                <div>
                    <span>Certifié le : {{ template.certificateDate|date('d/m/Y') }}</span><br>
                    <span>Identifiant : {{ template.identifier }}</span>
                </div>
                <div>
                    <strong>{{ template.assistantDirectorName }}</strong><br>
                    <span style="color:#7a8ab0;">Directeur adjoint</span>
                </div>
            </div>
        </div>

        <p style="text-align:center; margin-top:1rem; font-size:12px; color:#bbb;">Vérifié par Certicampus</p>
    </div>
</div>
{% endblock %}