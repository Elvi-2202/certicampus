{% extends 'base.html.twig' %}

{% block body %}
<div style="font-family: Georgia, serif; color: #2c3e6b; max-width: 700px; margin: 40px auto; padding: 40px; border: 8px solid #a8b8d8; text-align: center;">
    <h1>✅ Certificat valide</h1>
    <p><strong>Étudiant :</strong> {{ template.studentName }}</p>
    <p><strong>Formation :</strong> {{ template.schoolName }}</p>
    <p><strong>Directeur :</strong> {{ template.directorName }}</p>
    <p><strong>Date :</strong> {{ template.certificateDate|date('d/m/Y') }}</p>
    <p><strong>Identifiant :</strong> {{ template.identifier }}</p>
</div>
{% endblock %}